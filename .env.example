# ==============================================
# XINZAYR PORTFOLIO - VARIABLES DE ENTORNO
# ==============================================
#
# Este archivo contiene ejemplos de las variables de entorno necesarias
# para el funcionamiento completo del portfolio.
#
# INSTRUCCIONES:
# 1. Copia este archivo como `.env` en la raíz del proyecto
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA commites el archivo `.env` al repositorio
#
# ==============================================

# ==============================================
# GITHUB API CONFIGURATION
# ==============================================
# Token de acceso personal de GitHub para obtener repositorios
# Permisos necesarios: repo (read), user (read)
# Generar en: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=tu_username_github

# ==============================================
# DISCORD INTEGRATION (LANYARD API)
# ==============================================
# ID de usuario de Discord para mostrar estado
# Encontrar en: Configuración Discord > Avanzado > Modo desarrollador > Click derecho usuario > Copiar ID

# Variables públicas (accesibles en cliente)
PUBLIC_DISCORD_USER_ID=123456789012345678
PUBLIC_LANYARD_API=true

# Variables privadas (solo servidor)
DISCORD_USER_ID=123456789012345678
LANYARD_API=true

# ==============================================
# SPOTIFY WEB API
# ==============================================
# Credenciales de la aplicación Spotify
# Crear app en: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=32_caracteres_alfanumericos
SPOTIFY_CLIENT_SECRET=32_caracteres_alfanumericos

# Token de actualización para acceso persistente
# Obtener siguiendo el flujo OAuth de Spotify
SPOTIFY_REFRESH_TOKEN=AQC...token_muy_largo...xyz

# ==============================================
# INFORMACIÓN DEL PERFIL
# ==============================================
# Información personal para el portfolio
PROFILE_NAME="Tu Nombre"
PROFILE_EMAIL="tu-email@dominio.com"
PROFILE_DESCRIPTION="Tu descripción profesional"
PROFILE_LOCATION="Tu ubicación"
PROFILE_AVATAR_URL="https://github.com/tu_username.png"

# ==============================================
# CONFIGURACIÓN DE DESARROLLO
# ==============================================
# Configuraciones opcionales para desarrollo
NODE_ENV=development
DEBUG=false

# ==============================================
# CONFIGURACIÓN DE ANALYTICS (OPCIONAL)
# ==============================================
# Google Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Vercel Analytics
# VERCEL_ANALYTICS=true

# ==============================================
# CONFIGURACIÓN DE CONTACTO (OPCIONAL)
# ==============================================
# EmailJS para formulario de contacto
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# ==============================================
# NOTAS DE SEGURIDAD
# ==============================================
#
# IMPORTANTE:
# - Mantén estas credenciales privadas
# - Rota los tokens regularmente
# - Usa diferentes credenciales para desarrollo y producción
# - Revisa los permisos de los tokens periódicamente
# - Nunca hardcodees credenciales en el código
#
# PARA PRODUCCIÓN:
# - Configura estas variables en tu servicio de hosting
# - Vercel: Settings > Environment Variables
# - Netlify: Site settings > Environment variables
# - GitHub Pages: Settings > Secrets and variables > Actions
#
# ==============================================
