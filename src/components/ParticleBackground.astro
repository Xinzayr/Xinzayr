---
// Componente de Fondo de Partículas Interactivo y Optimizado
---
<div id="tsparticles" class="fixed inset-0 -z-10 pointer-events-none opacity-40 md:opacity-50"></div>

<script>
  // Usaremos importaciones dinámicas para evitar problemas de SSR en Astro
  async function initParticles() {
    try {
      const { tsParticles } = await import("@tsparticles/engine");
      const { loadSlim } = await import("@tsparticles/slim");
      
      await loadSlim(tsParticles);

      // Detección de móvil para optimizar drásticamente el rendimiento
      const isMobile = typeof window !== 'undefined' && (window.innerWidth < 768 || navigator.maxTouchPoints > 0);
      
      await tsParticles.load("tsparticles", {
        background: {
          color: {
            value: "transparent",
          },
        },
        fpsLimit: isMobile ? 30 : 60,
        interactivity: {
          events: {
            onHover: {
              enable: !isMobile,
              mode: "grab",
              parallax: {
                enable: !isMobile,
                force: 15,
                smooth: 10
              }
            },
            onClick: {
              enable: !isMobile,
              mode: "push",
            },
          },
          modes: {
            grab: {
              distance: 120,
              links: {
                opacity: 0.4,
                color: "#06b6d4"
              }
            },
            push: {
              quantity: 2,
            },
          },
        },
        particles: {
          color: {
            value: ["#06b6d4", "#10b981", "#a855f7", "#3b82f6"],
          },
          links: {
            color: "#ffffff",
            distance: isMobile ? 100 : 140,
            enable: true,
            opacity: isMobile ? 0.05 : 0.1,
            width: 1,
            triangles: {
              enable: !isMobile, // Triángulos desactivados en móvil para evitar cálculo Delaunay O(N³)
              opacity: 0.05
            }
          },
          move: {
            direction: "none",
            enable: true,
            outModes: {
              default: "bounce",
            },
            random: true,
            speed: isMobile ? 0.4 : 0.8,
            straight: false,
          },
          number: {
            density: {
              enable: true,
              area: isMobile ? 1200 : 800
            },
            value: isMobile ? 12 : 50, // Solo 12 partículas en móvil vs 50 en escritorio
          },
          opacity: {
            value: isMobile ? 0.4 : 0.6,
          },
          shape: {
            type: "circle",
          },
          size: {
            value: { min: 1, max: isMobile ? 2 : 3 },
          },
        },
        detectRetina: !isMobile,
      });
    } catch (e) {
      console.error("No se pudo inicializar las partículas", e);
    }
  }

  // Ejecutar solo en el navegador
  if (typeof window !== 'undefined') {
    document.addEventListener('astro:page-load', () => {
      initParticles();
    });
    
    initParticles();
  }
</script>
