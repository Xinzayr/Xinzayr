---
// Componente de Fondo de Partículas Interactivos
---
<div id="tsparticles" class="fixed inset-0 -z-10 pointer-events-none opacity-50"></div>

<script>
  // Usaremos importaciones dinámicas para evitar problemas de SSR en Astro
  async function initParticles() {
    try {
      const { tsParticles } = await import("@tsparticles/engine");
      const { loadSlim } = await import("@tsparticles/slim");
      
      await loadSlim(tsParticles);
      
      await tsParticles.load("tsparticles", {
        background: {
          color: {
            value: "transparent",
          },
        },
        fpsLimit: 60,
        interactivity: {
          events: {
            onHover: {
              enable: true,
              mode: "grab",
              parallax: {
                enable: true,
                force: 20,
                smooth: 10
              }
            },
            onClick: {
              enable: true,
              mode: "push",
            },
          },
          modes: {
            grab: {
              distance: 140,
              links: {
                opacity: 0.5,
                color: "#06b6d4"
              }
            },
            push: {
              quantity: 2,
            },
          },
        },
        particles: {
          color: {
            value: ["#06b6d4", "#10b981", "#a855f7", "#3b82f6"],
          },
          links: {
            color: "#ffffff",
            distance: 150,
            enable: true,
            opacity: 0.1,
            width: 1,
            triangles: {
              enable: true,
              opacity: 0.05
            }
          },
          move: {
            direction: "none",
            enable: true,
            outModes: {
              default: "bounce",
            },
            random: true,
            speed: 0.8,
            straight: false,
          },
          number: {
            density: {
              enable: true,
              area: 800
            },
            value: 60,
          },
          opacity: {
            value: 0.6,
          },
          shape: {
            type: "circle",
          },
          size: {
            value: { min: 1, max: 3 },
          },
        },
        detectRetina: true,
      });
    } catch (e) {
      console.error("No se pudo inicializar las partículas", e);
    }
  }

  // Ejecutar solo en el navegador
  if (typeof window !== 'undefined') {
    // Escuchar el evento de vista de Astro para que no se pierdan las partículas al navegar (ViewTransitions)
    document.addEventListener('astro:page-load', () => {
      initParticles();
    });
    
    // Ejecutar de inmediato la primera vez
    initParticles();
  }
</script>
