---
// Fondo Estático Futurista Ultra-Rápido (100% CSS, 0% JS, 0% Lag en Móviles)
---
<div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden bg-black">
	<!-- Resplandor Creador Superior Izquierdo (Cian) -->
	<div class="absolute -top-40 -left-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px]"></div>

	<!-- Resplandor Creador Inferior Derecho (Violeta) -->
	<div class="absolute -bottom-40 -right-40 w-96 h-96 bg-purple-500/10 rounded-full blur-[120px]"></div>

	<!-- Resplandor Central (Azul) -->
	<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/5 rounded-full blur-[150px]"></div>
</div>
