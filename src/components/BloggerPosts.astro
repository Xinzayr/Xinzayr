---
// Componente para obtener y mostrar posts del blog de Blogger
import { API_CONFIG } from '../consts';
import { Image } from 'astro:assets';
import Parser from 'rss-parser';

interface Props {
	variant?: 'featured' | 'grid' | 'compact';
	maxPosts?: number;
	showFeatured?: boolean;
}

const { variant = 'grid', maxPosts = 6, showFeatured = true } = Astro.props;

interface BlogPost {
	id: string;
	title: string;
	content: string;
	excerpt: string;
	url: string;
	published: string;
	updated: string;
	labels?: string[];
	author: {
		displayName: string;
		url?: string;
		image?: {
			url: string;
		};
	};
	images?: string[];
	thumbnail?: string;
}

let posts: BlogPost[] = [];
let error: string | null = null;

try {
	// Intentar obtener posts del feed RSS
	const parser = new Parser({
		customFields: {
			item: ['media:thumbnail', 'content:encoded']
		}
	});
	const feed = await parser.parseURL(API_CONFIG.blogger.feedRssUrl);

	if (feed && feed.items) {
		posts = feed.items.slice(0, maxPosts).map((item: any) => {
			let thumbnail = '';
			let images: string[] = [];
			const htmlContent = item['content:encoded'] || item.content || '';

			if (htmlContent) {
				const imgRegex = /<img[^>]+src="([^">]+)"/g;
				let match;
				while ((match = imgRegex.exec(htmlContent)) !== null) {
					images.push(match[1]);
				}
				if (images.length > 0) {
					thumbnail = images[0];
				}
			}

			// Intentar usar media:thumbnail si existe
			if (!thumbnail && item['media:thumbnail']) {
				thumbnail = item['media:thumbnail'].$?.url || item['media:thumbnail'];
			}

			// Crear excerpt del contenido
			let excerpt = item.contentSnippet || item.summary || '';
			if (!excerpt && htmlContent) {
				excerpt = htmlContent
					.replace(/<[^>]*>/g, '')
					.replace(/\s+/g, ' ')
					.trim()
					.substring(0, 200) + '...';
			}

			return {
				id: item.guid || item.id || Math.random().toString(36),
				title: item.title || 'Sin título',
				content: htmlContent,
				excerpt,
				url: item.link || '#',
				published: item.isoDate || item.pubDate,
				updated: item.isoDate || item.pubDate,
				labels: item.categories || [],
				author: {
					displayName: item.creator || item.author || feed.title || 'xinzayr'
				},
				images,
				thumbnail
			};
		});
	} else {
		error = `No se encontraron posts en el feed`;
	}
} catch (e) {
	error = `Error de conexión: ${e instanceof Error ? e.message : 'Error desconocido'}`;
	console.warn('Error fetching RSS posts:', e);
}

// Función para formatear fecha
function formatDate(dateString: string): string {
	try {
		const date = new Date(dateString);
		return date.toLocaleDateString('es-ES', {
			year: 'numeric',
			month: 'long',
			day: 'numeric'
		});
	} catch {
		return 'Fecha no disponible';
	}
}

// Función para calcular tiempo de lectura estimado
function getReadingTime(content: string): string {
	const wordsPerMinute = 200;
	const wordCount = content.replace(/<[^>]*>/g, '').split(/\s+/).length;
	const minutes = Math.ceil(wordCount / wordsPerMinute);
	return `${minutes} min de lectura`;
}
---

{error ? (
	<!-- Error State -->
	<div class="liquid-glass-card p-8 text-center">
		<svg class="w-12 h-12 text-cyber-pink mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.664-.833-2.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
		</svg>
		<h3 class="text-lg font-semibold text-white mb-2">Error al cargar posts</h3>
		<p class="text-white/60 text-sm mb-4">{error}</p>
		<a
			href={API_CONFIG.blogger.blogUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center space-x-2 px-4 py-2 liquid-glass-btn text-white/80 hover:text-white transition-colors"
		>
			<span>Ver blog completo</span>
			<svg class="w-4 h-4 text-cyber-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
			</svg>
		</a>
	</div>
) : posts.length === 0 ? (
	<!-- Empty State -->
	<div class="liquid-glass-card p-8 text-center">
		<svg class="w-12 h-12 text-white/20 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
		</svg>
		<h3 class="text-lg font-semibold text-white mb-2">No hay posts disponibles</h3>
		<p class="text-white/60 text-sm mb-4">Aún no hay contenido publicado en el blog.</p>
		<a
			href={API_CONFIG.blogger.blogUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center space-x-2 px-4 py-2 liquid-glass-btn text-white/80 hover:text-white transition-colors"
		>
			<span>Visitar blog</span>
			<svg class="w-4 h-4 text-cyber-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
			</svg>
		</a>
	</div>
) : (
	<div>
		{variant === 'featured' && showFeatured && posts.length > 0 && (
			<!-- Featured Post -->
			<div class="mb-12">
				<h2 class="text-2xl font-bold text-white/90 mb-6">Último Post del Blog</h2>
				<div class="liquid-glass-card p-0 overflow-hidden">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
						<!-- Image -->
						<div class="relative aspect-video lg:aspect-square">
							{posts[0].thumbnail ? (
								<Image
									src={posts[0].thumbnail}
									alt={posts[0].title}
									inferSize={true}
									class="w-full h-full object-cover"
									loading="lazy"
								/>
							) : (
								<div class="w-full h-full bg-gradient-cyber opacity-30 flex items-center justify-center">
									<svg class="w-16 h-16 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
									</svg>
								</div>
							)}
							<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
						</div>

						<!-- Content -->
						<div class="p-8 lg:p-12 flex flex-col justify-center">
							{posts[0].labels && posts[0].labels.length > 0 && (
								<div class="flex flex-wrap gap-2 mb-4">
									{posts[0].labels.slice(0, 3).map((label) => (
										<span class="px-2 py-1 text-xs bg-white/5 border border-white/10 text-cyber-cyan rounded-md font-mono">
											#{label}
										</span>
									))}
								</div>
							)}

							<h3 class="text-2xl lg:text-3xl font-bold text-white/90 mb-4 leading-tight">
								{posts[0].title}
							</h3>

							<p class="text-white/70 mb-6 leading-relaxed">
								{posts[0].excerpt}
							</p>

							<div class="flex items-center justify-between flex-wrap gap-4">
								<div class="flex items-center space-x-4 text-white/60 text-sm">
									<div class="flex items-center space-x-2">
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
										</svg>
										<span>{formatDate(posts[0].published)}</span>
									</div>
									<div class="flex items-center space-x-2">
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										<span>{getReadingTime(posts[0].content)}</span>
									</div>
								</div>

								<a
									href={posts[0].url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center space-x-2 px-4 py-2 liquid-glass-btn hover:text-cyber-cyan text-white/90 font-medium transition-colors"
								>
									<span>Leer en blog</span>
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
									</svg>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		)}

		{variant === 'grid' && (
			<!-- Grid Posts -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{posts.slice(0).map((post) => (
					<article class="liquid-glass-card p-0 overflow-hidden flex flex-col">
						<!-- Post Image -->
						<div class="relative aspect-video">
							{post.thumbnail ? (
								<Image
									src={post.thumbnail}
									alt={post.title}
									inferSize={true}
									class="w-full h-full object-cover"
									loading="lazy"
								/>
							) : (
								<div class="w-full h-full bg-gradient-dark flex items-center justify-center">
									<svg class="w-12 h-12 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
									</svg>
								</div>
							)}
							<div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
						</div>

						<!-- Post Content -->
						<div class="p-6">
							{post.labels && post.labels.length > 0 && (
								<div class="flex flex-wrap gap-1 mb-3">
									{post.labels.slice(0, 2).map((label) => (
										<span class="px-2 py-1 text-xs bg-white/5 border border-white/10 text-cyber-cyan rounded font-mono">
											#{label}
										</span>
									))}
								</div>
							)}

							<h3 class="text-lg font-bold text-white/90 mb-3 leading-tight line-clamp-2 group-hover:text-cyber-cyan transition-colors">
								{post.title}
							</h3>

							<p class="text-white/70 text-sm mb-4 leading-relaxed line-clamp-3">
								{post.excerpt}
							</p>

							<div class="flex items-center justify-between text-xs text-white/60 mb-4">
								<span>{formatDate(post.published)}</span>
								<span>{getReadingTime(post.content)}</span>
							</div>

							<a
								href={post.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center space-x-2 text-cyber-cyan hover:text-cyber-purple font-medium text-sm transition-colors mt-auto pt-2"
							>
								<span>Leer más</span>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
								</svg>
							</a>
						</div>
					</article>
				))}
			</div>
		)}

		{variant === 'compact' && (
			<!-- Compact List -->
			<div class="space-y-4">
				{posts.map((post) => (
					<article class="liquid-glass-card p-4">
						<div class="flex items-start space-x-4">
							{post.thumbnail && (
								<div class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden">
									<Image
										src={post.thumbnail}
										alt={post.title}
										inferSize={true}
										class="w-full h-full object-cover"
										loading="lazy"
									/>
								</div>
							)}
							<div class="flex-1 min-w-0">
								<h3 class="text-white font-medium mb-1 line-clamp-1">
									{post.title}
								</h3>
								<p class="text-white/70 text-sm mb-2 line-clamp-2">
									{post.excerpt}
								</p>
								<div class="flex items-center justify-between text-xs text-white/60">
									<span>{formatDate(post.published)}</span>
									<a
										href={post.url}
										target="_blank"
										rel="noopener noreferrer"
										class="text-cyber-cyan hover:text-cyber-purple transition-colors"
									>
										Leer →
									</a>
								</div>
							</div>
						</div>
					</article>
				))}
			</div>
		)}

		<!-- View All Link -->
		<div class="text-center mt-8">
			<a
				href={API_CONFIG.blogger.blogUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center space-x-2 px-6 py-3 liquid-glass-btn text-white/80 hover:text-white font-medium"
			>
				<span>Ver todos los posts</span>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
				</svg>
			</a>
		</div>
	</div>
)}

<style>
	.line-clamp-1 {
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
