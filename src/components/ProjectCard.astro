---
export interface Props {
	title: string;
	shortDescription: string;
	imageUrl?: string;
	tags: string[];
	stack: string[];
	repositoryUrl?: string;
	demoUrl?: string;
	featured?: boolean;
	href: string;
}

const {
	title,
	shortDescription,
	imageUrl,
	tags,
	stack,
	repositoryUrl,
	demoUrl,
	featured = false,
	href
} = Astro.props;
---

<article class={`glass rounded-xl p-6 glass-hover transition-all duration-300 ${featured ? 'ring-2 ring-blue-500/30 glow' : ''}`}>
	<!-- Image -->
	{imageUrl && (
		<div class="relative overflow-hidden rounded-lg mb-4 bg-white/5 aspect-video">
			<img
				src={imageUrl}
				alt={title}
				class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
				loading="lazy"
				width="400"
				height="225"
			/>
			{featured && (
				<div class="absolute top-2 left-2">
					<span class="px-2 py-1 text-xs font-medium bg-blue-500 text-white rounded-full">
						Destacado
					</span>
				</div>
			)}
		</div>
	)}

	<!-- Content -->
	<div class="space-y-3">
		<h3 class="text-xl font-semibold text-white hover:text-blue-400 transition-colors">
			<a href={href} class="block">
				{title}
			</a>
		</h3>

		<p class="text-white/70 text-sm leading-relaxed">
			{shortDescription}
		</p>

		<!-- Tech Stack -->
		<div class="flex flex-wrap gap-2">
			{stack.map((tech) => (
				<span class="px-2 py-1 text-xs bg-white/10 text-white/80 rounded-md font-mono">
					{tech}
				</span>
			))}
		</div>

		<!-- Tags -->
		{tags.length > 0 && (
			<div class="flex flex-wrap gap-2">
				{tags.map((tag) => (
					<span class="px-2 py-1 text-xs bg-blue-500/20 text-blue-300 rounded-md">
						#{tag}
					</span>
				))}
			</div>
		)}

		<!-- Actions -->
		<div class="flex items-center justify-between pt-4 border-t border-white/10">
			<a
				href={href}
				class="text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors"
			>
				Ver detalles →
			</a>

			<div class="flex items-center space-x-3">
				{repositoryUrl && (
					<a
						href={repositoryUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/60 hover:text-white transition-colors"
						aria-label="Ver código fuente"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
						</svg>
					</a>
				)}

				{demoUrl && (
					<a
						href={demoUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/60 hover:text-white transition-colors"
						aria-label="Ver demo"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
						</svg>
					</a>
				)}
			</div>
		</div>
	</div>
</article>
