---
import DiscordStatus from './DiscordStatus.astro';
import SpotifyNowPlaying from './SpotifyNowPlaying.astro';
import { EXTERNAL_RESOURCES, PERSONAL_INFO } from '../consts';

// Información de deployment temporal
const deploymentInfo = {
  displayName: 'Vercel',
  isDynamic: true,
  alternativeUrl: null,
};

const currentYear = new Date().getFullYear();
---

<footer
  class="border-t border-gold-400/15 bg-gradient-to-b from-black/90 to-black-pure backdrop-blur-sm relative"
>
  <!-- Efecto de brillo sutil en el fondo -->
  <div class="absolute inset-0 bg-gradient-to-t from-gold-400/3 to-transparent pointer-events-none">
  </div>

  <div class="relative w-full px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Section: Brand & Navigation -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-8">
      <!-- Brand Identity -->
      <div class="flex items-center space-x-4">
        <div
          class="w-12 h-12 rounded-xl border-2 border-gold-400 shadow-xl shadow-gold-400/30 overflow-hidden"
        >
          <img
            src="https://www.gravatar.com/avatar/977ea9a49bad6103d6cf96df4ace2cdf?s=48&d=identicon"
            alt="xinzayr profile"
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <h2 class="font-display font-bold text-xl text-white tracking-wide">xinzayr</h2>
          <p class="text-gold-300/90 text-sm font-mono">Desarrollador Junior</p>
          <p class="text-white/70 text-xs mt-1 max-w-md">
            Con visión hacia un futuro libre y sin censura
          </p>
        </div>
      </div>

      <!-- Quick Navigation -->
      <nav class="flex flex-wrap gap-3" aria-label="Footer navigation">
        <a
          href="/projects"
          class="cursor-glow inline-flex items-center px-3 py-2 rounded-lg text-white/80 hover:text-white border border-gold-400/20 hover:border-gold-400/50 transition-all duration-300 text-sm"
        >
          <span>Proyectos</span>
        </a>
        <a
          href="/blog"
          class="cursor-glow inline-flex items-center px-3 py-2 rounded-lg text-white/80 hover:text-white border border-neon-blue/20 hover:border-neon-blue/50 transition-all duration-300 text-sm"
        >
          <span>Blog</span>
        </a>
        <a
          href="/contact"
          class="cursor-glow inline-flex items-center px-3 py-2 rounded-lg text-white/80 hover:text-white border border-neon-green/20 hover:border-neon-green/50 transition-all duration-300 text-sm"
        >
          <span>Contacto</span>
        </a>
        <a
          href="/cv"
          class="cursor-glow inline-flex items-center px-3 py-2 rounded-lg text-white/80 hover:text-white border border-pearl-300/20 hover:border-pearl-300/50 transition-all duration-300 text-sm"
        >
          <span>CV</span>
        </a>
      </nav>
    </div>

    <!-- Main Content: Status & Social -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Real-time Status -->
      <div class="md:col-span-2 lg:col-span-1">
        <h3 class="text-white font-semibold text-sm mb-4 flex items-center">
          <span class="w-2 h-2 bg-neon-green rounded-full mr-2 animate-pulse"></span>
          Estados en Tiempo Real
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Discord Status -->
          <div class="bg-white/5 backdrop-blur rounded-lg p-4 border border-neon-purple/30">
            <div class="flex items-center space-x-2 mb-3">
              <div class="w-2 h-2 bg-neon-purple rounded-full animate-pulse"></div>
              <span class="text-neon-purple font-medium text-sm">Discord</span>
            </div>
            <DiscordStatus variant="detailed" />
          </div>
          <!-- Spotify Status -->
          <div class="bg-white/5 backdrop-blur rounded-lg p-4 border border-neon-green/30">
            <div class="flex items-center space-x-2 mb-3">
              <div class="w-2 h-2 bg-neon-green rounded-full animate-pulse"></div>
              <span class="text-neon-green font-medium text-sm">Spotify</span>
            </div>
            <SpotifyNowPlaying variant="detailed" showWhenNotPlaying={true} />
          </div>
        </div>
      </div>

      <!-- Social Networks & Support -->
      <div class="flex flex-col justify-between">
        <div>
          <h3 class="text-white font-semibold text-sm mb-4">Conecta Conmigo</h3>
          <div class="flex space-x-4 mb-6">
            <a
              href={EXTERNAL_RESOURCES.GITHUB_PROFILE}
              target="_blank"
              rel="noopener noreferrer"
              class="cursor-glow group p-3 rounded-lg border border-white/10 hover:border-gold-400/50 transition-all duration-300"
              aria-label="GitHub"
            >
              <svg
                class="w-5 h-5 text-white group-hover:text-gold-400 transition-colors"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
                ></path>
              </svg>
            </a>
            <a
              href="https://linkedin.com/in/xinzayr"
              target="_blank"
              rel="noopener noreferrer"
              class="cursor-glow group p-3 rounded-lg border border-white/10 hover:border-blue-400/50 transition-all duration-300"
              aria-label="LinkedIn"
            >
              <svg
                class="w-5 h-5 text-white group-hover:text-blue-400 transition-colors"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Support Links -->
        <div>
          <h4 class="text-neon-pink font-medium text-sm mb-3">Apóyame</h4>
          <div class="space-y-2">
            <a
              href={EXTERNAL_RESOURCES.GITHUB_SPONSORS}
              target="_blank"
              rel="noopener noreferrer"
              class="cursor-glow flex items-center space-x-2 text-white/80 hover:text-neon-pink transition-all duration-300 text-sm"
            >
              <span>GitHub Sponsors</span>
            </a>
            <a
              href="https://ko-fi.com/xinzayr"
              target="_blank"
              rel="noopener noreferrer"
              class="cursor-glow flex items-center space-x-2 text-white/80 hover:text-blue-400 transition-all duration-300 text-sm"
            >
              <span>Ko-fi</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Environment & Tools -->
      <div class="flex flex-col justify-between">
        <div class="bg-white/5 backdrop-blur rounded-lg p-3 border border-pearl-300/30 mb-4">
          <div class="flex items-center space-x-2 text-sm">
            <div class="w-2 h-2 rounded-full bg-neon-green animate-pulse"></div>
            <span class="text-white/90"
              >Alojado en <span class="font-semibold text-gold-400"
                >{deploymentInfo.displayName}</span
              ></span
            >
          </div>
        </div>

        <!-- World Clocks -->
        <div>
          <h4 class="text-white font-medium text-sm mb-3">Zona Horaria</h4>
          <div class="space-y-2">
            <div
              class="flex items-center justify-between px-3 py-2 rounded-lg bg-white/5 border border-neon-blue/30"
            >
              <span class="text-neon-blue font-mono text-xs">Florida</span>
              <span id="florida-compact" class="text-white font-mono text-sm font-bold">--:--</span>
            </div>
            <div
              class="flex items-center justify-between px-3 py-2 rounded-lg bg-white/5 border border-neon-green/30"
            >
              <span class="text-neon-green font-mono text-xs">Ecuador</span>
              <span id="guayaquil-compact" class="text-white font-mono text-sm font-bold"
                >--:--</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright & Legal -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between pt-6 border-t border-gold-400/20"
    >
      <div class="text-center sm:text-left mb-4 sm:mb-0">
        <p class="text-white/85 text-sm">
          © {currentYear}
          <span class="text-gold-400 font-semibold">xinzayr</span>
        </p>
        <p class="text-white/60 text-xs mt-1">
          Desarrollado con <span class="text-neon-blue">Astro</span> y <span
            class="text-neon-purple">TailwindCSS</span
          >
        </p>
      </div>

      <div class="flex items-center space-x-4 text-xs">
        <a href="/rss.xml" class="cursor-glow text-white/70 hover:text-gold-400 transition-colors"
          >RSS</a
        >
        <a
          href="/sitemap-index.xml"
          class="cursor-glow text-white/70 hover:text-pearl-300 transition-colors">Sitemap</a
        >
      </div>
    </div>
  </div>

  <!-- Script para cursor tracking y relojes -->
  <script>
    // Cursor glow tracking
    document.addEventListener('DOMContentLoaded', function () {
      const cursorElements = document.querySelectorAll('.cursor-glow') as NodeListOf<HTMLElement>;

      cursorElements.forEach((element: HTMLElement) => {
        element.addEventListener('mousemove', function (e: MouseEvent) {
          const rect = this.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          this.style.setProperty('--mouse-x', x + 'px');
          this.style.setProperty('--mouse-y', y + 'px');
        });
      });

      // World Clock functionality
      function updateTime() {
        const now = new Date();

        // Florida (EST/EDT)
        const floridaTime = new Date(now.toLocaleString('en-US', { timeZone: 'America/New_York' }));
        const floridaElement = document.getElementById('florida-compact');
        if (floridaElement) {
          floridaElement.textContent = floridaTime.toLocaleTimeString('en-US', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
          });
        }

        // Ecuador (ECT)
        const ecuadorTime = new Date(
          now.toLocaleString('en-US', { timeZone: 'America/Guayaquil' }),
        );
        const ecuadorElement = document.getElementById('guayaquil-compact');
        if (ecuadorElement) {
          ecuadorElement.textContent = ecuadorTime.toLocaleTimeString('en-US', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
          });
        }
      }

      // Actualizar relojes cada segundo
      updateTime();
      setInterval(updateTime, 1000);
    });
  </script>
</footer>
