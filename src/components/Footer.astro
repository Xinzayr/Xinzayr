---
import DiscordStatus from './DiscordStatus.astro';
import SpotifyNowPlaying from './SpotifyNowPlaying.astro';
import WorldClock from './WorldClock.astro';
import { EXTERNAL_RESOURCES, PERSONAL_INFO } from '../consts';

// Información de deployment temporal
const deploymentInfo = {
	displayName: 'Vercel',
	isDynamic: true,
	alternativeUrl: null
};

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-black/50 backdrop-blur-sm">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
			<!-- Brand & Description -->
			<div class="col-span-1 md:col-span-1">
				<div class="flex items-center space-x-2 mb-4">
					<div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
						<span class="text-white font-mono font-bold text-sm">X</span>
					</div>
					<span class="font-mono font-semibold text-white text-lg">xinzayr</span>
				</div>
				<p class="text-white/70 text-sm mb-4">
					Desarrollador Junior en constante aprendizaje. Apasionado por crear proyectos web
					y explorar nuevas tecnologías en mi camino de crecimiento profesional.
				</p>

				<!-- Environment Info -->
				<div class="flex flex-col space-y-2">
					<div class="flex items-center space-x-2 text-xs text-white/60">
						<span class="w-2 h-2 rounded-full bg-green-400"></span>
						<span>Alojado en {deploymentInfo.displayName}</span>
					</div>
					{deploymentInfo.alternativeUrl && (
						<a
							href={deploymentInfo.alternativeUrl}
							class="text-xs text-blue-400 hover:text-blue-300 transition-colors inline-flex items-center space-x-1"
						>
							<span>Ver versión {deploymentInfo.isDynamic ? 'estática' : 'dinámica'}</span>
							<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
							</svg>
						</a>
					)}
				</div>
			</div>

			<!-- Quick Links -->
			<div>
				<h3 class="text-white font-semibold text-sm mb-4">Enlaces rápidos</h3>
				<ul class="space-y-2">
					<li><a href="/projects" class="text-white/70 hover:text-white text-sm transition-colors">Proyectos</a></li>
					<li><a href="/blog" class="text-white/70 hover:text-white text-sm transition-colors">Blog</a></li>
					<li><a href="/tools" class="text-white/70 hover:text-white text-sm transition-colors">Herramientas</a></li>
					<li><a href="/contact" class="text-white/70 hover:text-white text-sm transition-colors">Contacto</a></li>
					<li><a href="/about" class="text-white/70 hover:text-white text-sm transition-colors">CV</a></li>
				</ul>
			</div>

			<!-- Estados: Discord & Spotify -->
			<div>
				<h3 class="text-white font-semibold text-sm mb-4">Estados</h3>

				<!-- Discord -->
				<div class="mb-6">
					<h4 class="text-white/80 font-medium text-xs mb-3">Discord</h4>
					<DiscordStatus variant="detailed" />
				</div>

				<!-- Spotify -->
				<div>
					<h4 class="text-white/80 font-medium text-xs mb-3">Spotify</h4>
					<SpotifyNowPlaying variant="detailed" showWhenNotPlaying={true} />
				</div>
			</div>			<!-- Social & Donations -->
			<div>
				<h3 class="text-white font-semibold text-sm mb-4">Conecta conmigo</h3>

				<!-- Social Links -->
				<div class="grid grid-cols-3 gap-2 mb-6">
					<a
						href={EXTERNAL_RESOURCES.GITHUB_PROFILE}
						target="_blank"
						rel="noopener noreferrer"
						class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
						aria-label="GitHub"
					>
						<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
						</svg>
					</a>

					<a
						href={EXTERNAL_RESOURCES.X_TWITTER}
						target="_blank"
						rel="noopener noreferrer"
						class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
						aria-label="X (Twitter)"
					>
						<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
					</a>

					<a
						href={EXTERNAL_RESOURCES.DISCORD_INVITE}
						target="_blank"
						rel="noopener noreferrer"
						class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
						aria-label="Discord"
					>
						<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
							<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
						</svg>
					</a>

					<a
						href={EXTERNAL_RESOURCES.LINKEDIN}
						target="_blank"
						rel="noopener noreferrer"
						class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
						aria-label="LinkedIn"
					>
						<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>

					<a
						href={EXTERNAL_RESOURCES.INSTAGRAM}
						target="_blank"
						rel="noopener noreferrer"
						class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
						aria-label="Instagram"
					>
						<svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
						</svg>
					</a>
				</div>

				<!-- Donation Links -->
				<div>
					<h4 class="text-white/80 text-xs font-medium mb-3">Apóyame ❤️</h4>
					<div class="grid grid-cols-1 gap-2 text-xs">
						<a
							href={EXTERNAL_RESOURCES.PATREON}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center space-x-2 text-white/70 hover:text-white transition-colors"
						>
							<div class="w-4 h-4 rounded bg-orange-500/20 flex items-center justify-center">
								<svg class="w-2.5 h-2.5 text-orange-400" fill="currentColor" viewBox="0 0 24 24">
									<path d="M0 .48v23.04h4.22V.48zm15.385 0c-4.764 0-8.641 3.88-8.641 8.65 0 4.755 3.877 8.623 8.641 8.623 4.75 0 8.615-3.868 8.615-8.623C24 4.36 20.136.48 15.385.48z"/>
								</svg>
							</div>
							<span>Patreon</span>
						</a>

						<a
							href={EXTERNAL_RESOURCES.KOFI}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center space-x-2 text-white/70 hover:text-white transition-colors"
						>
							<div class="w-4 h-4 rounded bg-purple-500/20 flex items-center justify-center">
								<svg class="w-2.5 h-2.5 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
									<path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.061 11.493c.02 4.169 2.925 2.925 2.925 2.925s1.188.087 1.591.087c.403 0 .96-.087.96-.087s1.871-6.447 1.871-6.447h5.091s.456 6.447.456 6.447 2.064.087 2.467.087c.403 0 .96-.087.96-.087s-.456-13.455-.456-13.455c0 0 6.267-.317 6.267-7.317z"/>
								</svg>
							</div>
							<span>Ko-fi</span>
						</a>

						<a
							href={EXTERNAL_RESOURCES.GITHUB_SPONSORS}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center space-x-2 text-white/70 hover:text-white transition-colors"
						>
							<div class="w-4 h-4 rounded bg-pink-500/20 flex items-center justify-center">
								<svg class="w-2.5 h-2.5 text-pink-400" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
								</svg>
							</div>
							<span>Sponsors</span>
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Bottom Bar -->
		<div class="border-t border-white/10 mt-8 pt-6 flex flex-col sm:flex-row items-center justify-between">
			<p class="text-white/60 text-xs">
				© {currentYear} xinzayr. Desarrollado con Astro y TailwindCSS.
			</p>

			<div class="flex flex-col sm:flex-row items-center space-y-2 sm:space-y-0 sm:space-x-6 mt-4 sm:mt-0">
				<!-- Zona Horaria Compacta -->
				<div class="flex items-center space-x-4 text-xs">
					<div class="flex items-center space-x-1">
						<span class="text-blue-400 font-mono font-bold">FL, USA</span>
						<span id="florida-compact" class="text-white/60 font-mono">--:--</span>
					</div>
					<div class="flex items-center space-x-1">
						<span class="text-green-400 font-mono font-bold">EC</span>
						<span id="guayaquil-compact" class="text-white/60 font-mono">--:--</span>
					</div>
				</div>

				<!-- Links tradicionales -->
				<div class="flex items-center space-x-4">
					<a href="/rss.xml" class="text-white/60 hover:text-white text-xs transition-colors">RSS</a>
					<a href="/sitemap-index.xml" class="text-white/60 hover:text-white text-xs transition-colors">Sitemap</a>
				</div>
			</div>
		</div>
	</div>
</footer>

<script>
	// Relojes compactos para el footer
	function updateCompactClocks() {
		const now = new Date();

		// Florida (Eastern Time)
		const floridaTime = new Intl.DateTimeFormat('en-US', {
			timeZone: 'America/New_York',
			hour12: false,
			hour: '2-digit',
			minute: '2-digit'
		}).format(now);

		// Guayaquil (Ecuador Time)
		const guayaquilTime = new Intl.DateTimeFormat('en-US', {
			timeZone: 'America/Guayaquil',
			hour12: false,
			hour: '2-digit',
			minute: '2-digit'
		}).format(now);

		// Update DOM
		const floridaElement = document.getElementById('florida-compact');
		const guayaquilElement = document.getElementById('guayaquil-compact');

		if (floridaElement) floridaElement.textContent = floridaTime;
		if (guayaquilElement) guayaquilElement.textContent = guayaquilTime;
	}

	// Update immediately and then every second
	updateCompactClocks();
	setInterval(updateCompactClocks, 1000);

	// Update when page becomes visible again
	document.addEventListener('visibilitychange', () => {
		if (!document.hidden) {
			updateCompactClocks();
		}
	});
</script>
