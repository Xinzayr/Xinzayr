  'TypeScript': '#3178c6',
  'JavaScript': '#f7df1e',
  'Python': '#3776ab',
  'Dart': '#0175c2',
  'Solidity': '#363636',
  'HTML': '#e34f26',
  'CSS': '#1572b6',
  'Java': '#f89820',
  'C#': '#239120',
  'C++': '#00599c',
  'Go': '#00add8',
  'Rust': '#000000',
  'PHP': '#777bb4',
  'Ruby': '#cc342d',
  'Swift': '#fa7343',
  'Kotlin': '#7f52ff',
  'Vue': '#4fc08d',
  'React': '#61dafb',
  'Svelte': '#ff3e00',
  'Astro': '#ff5d01',
