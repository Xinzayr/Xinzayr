---
import { getCollection } from 'astro:content';
import { API_CONFIG } from '../consts';

interface Props {
  limit?: number;
  showPrivate?: boolean;
  excludeRepos?: string[]; // Repos a excluir si ya están en la sección destacada
}

const { limit = 12, showPrivate = false, excludeRepos = [] } = Astro.props;

// Obtener configuración desde variables de entorno o consts
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || API_CONFIG.github.token;
const GITHUB_USERNAME = import.meta.env.GITHUB_USERNAME || API_CONFIG.github.username || 'xinzayr';

// Obtener todos los proyectos del contenido local
const allProjects = await getCollection('projects');
const projectSlugs = allProjects.map(p => p.id); // Obtener los IDs/slugs de los proyectos

let githubRepos: any[] = [];

// Obtener repositorios de GitHub
if (GITHUB_USERNAME) {
  try {
    const headers: any = {
      'Accept': 'application/vnd.github.v3+json',
      'User-Agent': 'xinzayr-portfolio'
    };
    if (GITHUB_TOKEN) {
      headers['Authorization'] = `Bearer ${GITHUB_TOKEN}`;
    }
    const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=100`, {
      headers
    });
    if (response.ok) {
      const repos = await response.json();
      const rawRepos = repos
        .filter((repo: any) => showPrivate || !repo.private)
        .filter((repo: any) => !repo.archived)
        .filter((repo: any) => !excludeRepos.includes(repo.name))
        .slice(0, limit);

      githubRepos = await Promise.all(
        rawRepos.map(async (repo: any) => {
          const localProject = allProjects.find((p) => {
            const repoNameLower = repo.name.toLowerCase().replace(/[-_]/g, '');
            const idLower = p.id.toLowerCase().replace(/[-_]/g, '');
            return (
              repoNameLower.includes(idLower) ||
              idLower.includes(repoNameLower) ||
              p.id.toLowerCase() === repo.name.toLowerCase()
            );
          });

          let hasReadme = false;
          if (!localProject) {
            try {
              const readmeRes = await fetch(
                `https://api.github.com/repos/${GITHUB_USERNAME}/${repo.name}/readme`,
                { method: 'HEAD', headers }
              );
              hasReadme = readmeRes.status === 200;
            } catch (e) {
              hasReadme = false;
            }
          }

          const hasDocs = !!localProject || hasReadme;
          const docSlug = localProject ? localProject.id : repo.name;

          return {
            id: repo.id,
            name: repo.name,
            full_name: repo.full_name,
            description: repo.description || 'Sin descripción disponible',
            html_url: repo.html_url,
            homepage: repo.homepage,
            topics: repo.topics || [],
            language: repo.language,
            stargazers_count: repo.stargazers_count,
            forks_count: repo.forks_count,
            updated_at: repo.updated_at,
            created_at: repo.created_at,
            hasLocalContent: !!localProject,
            localProject,
            hasReadme,
            hasDocs,
            docSlug,
          };
        })
      );
    }
  } catch (error) {
    console.warn('Error fetching GitHub repositories for dynamic cards:', error);
    githubRepos = [];
  }
}

