---
export interface Props {
	title: string;
	description: string;
	pubDate: Date;
	heroImage?: string;
	tags?: string[];
	category?: string;
	href: string;
}

const { title, description, pubDate, heroImage, tags = [], category, href } = Astro.props;

// Formatear fecha
const formattedDate = new Intl.DateTimeFormat('es-ES', {
	year: 'numeric',
	month: 'long',
	day: 'numeric'
}).format(pubDate);
---

<article class="liquid-glass-card p-0 overflow-hidden transition-all duration-300 group flex flex-col">
	<!-- Image -->
	{heroImage && (
		<div class="relative overflow-hidden bg-white/5 aspect-video">
			<img
				src={heroImage}
				alt={title}
				class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
				loading="lazy"
				width="400"
				height="225"
			/>
			<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
		</div>
	)}

	<!-- Content -->
	<div class="p-6">
		<div class="space-y-3">
			<!-- Category & Date -->
			<div class="flex items-center justify-between text-xs text-white/60">
				{category && (
					<span class="px-2 py-1 bg-cyber-purple/20 text-cyber-purple border border-cyber-purple/30 rounded-md font-medium">
						{category}
					</span>
				)}
				<time datetime={pubDate.toISOString()}>
					{formattedDate}
				</time>
			</div>

			<!-- Title -->
			<h3 class="text-lg font-semibold text-white/90 group-hover:text-cyber-cyan transition-colors line-clamp-2">
				<a href={href} class="block">
					{title}
				</a>
			</h3>

			<!-- Description -->
			<p class="text-white/70 text-sm leading-relaxed line-clamp-3">
				{description}
			</p>

			<!-- Tags -->
			{tags.length > 0 && (
				<div class="flex flex-wrap gap-2 pt-2">
					{tags.slice(0, 3).map((tag) => (
						<span class="px-2 py-1 text-xs bg-white/5 border border-white/10 text-cyber-cyan rounded-md">
							#{tag}
						</span>
					))}
					{tags.length > 3 && (
						<span class="px-2 py-1 text-xs bg-white/10 text-white/60 rounded-md">
							+{tags.length - 3}
						</span>
					)}
				</div>
			)}

			<!-- Read More -->
			<div class="pt-4 border-t border-white/10 mt-auto">
				<a
					href={href}
					class="inline-flex items-center space-x-2 text-cyber-cyan hover:text-cyber-purple text-sm font-medium transition-colors group"
				>
					<span>Leer más</span>
					<svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>
		</div>
	</div>
</article>

<style>
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
