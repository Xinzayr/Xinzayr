---
// Componente para mostrar el estado de Discord mediante Lanyard API
interface Props {
  variant?: 'simple' | 'detailed';
  size?: 'sm' | 'md' | 'lg';
}

const { variant = 'simple', size = 'md' } = Astro.props;

const DISCORD_USER_ID =
  import.meta.env.PUBLIC_DISCORD_USER_ID ||
  import.meta.env.DISCORD_USER_ID ||
  '985292430758793308';
---

<discord-status data-userid={DISCORD_USER_ID} data-variant={variant} data-size={size} class="h-full block">
  {variant === 'simple' ? (
    <div class="flex items-center space-x-2 min-w-[80px]">
      <div class={`status-dot bg-gray-400 rounded-full animate-pulse ${size === 'sm' ? 'w-2 h-2' : size === 'lg' ? 'w-4 h-4' : 'w-3 h-3'}`}></div>
      <span class="status-text text-sm text-white/50">Discord...</span>
    </div>
  ) : (
    <div class="glass-card rounded-xl p-4 h-full min-h-[140px] flex flex-col justify-between border border-white/10 hover:border-cyber-cyan/30 transition-all duration-300">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <div class="w-2 h-2 bg-cyber-cyan rounded-full animate-pulse"></div>
          <span class="text-cyber-cyan font-semibold text-xs tracking-wider uppercase">Discord</span>
        </div>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-white/60 font-mono">Conectando...</span>
      </div>
      <div class="flex items-center space-x-3 my-2">
        <div class="w-10 h-10 bg-white/10 rounded-xl animate-pulse flex-shrink-0"></div>
        <div class="space-y-1.5 flex-1 min-w-0">
          <div class="w-24 h-3 bg-white/10 rounded animate-pulse"></div>
          <div class="w-16 h-2.5 bg-white/10 rounded animate-pulse"></div>
        </div>
      </div>
      <div class="pt-2 border-t border-white/5">
        <span class="text-white/40 text-xs font-mono">Cargando estado...</span>
      </div>
    </div>
  )}
</discord-status>

<script>
  class DiscordStatus extends HTMLElement {
    private pollInterval: number | null = null;

    constructor() {
      super();
    }

    async fetchStatus() {
      const userId = this.dataset.userid;
      const variant = this.dataset.variant;
      const size = this.dataset.size || 'md';

      const sizeClasses = {
        sm: 'w-2 h-2',
        md: 'w-3 h-3',
        lg: 'w-4 h-4'
      };

      const statusColors = {
        online: 'bg-cyber-green',
        idle: 'bg-amber-400',
        dnd: 'bg-rose-500',
        offline: 'bg-gray-400'
      };

      const statusLabels = {
        online: 'En línea',
        idle: 'Ausente',
        dnd: 'No molestar',
        offline: 'Desconectado'
      };

      try {
        const response = await fetch(`https://api.lanyard.rest/v1/users/${userId}`);
        if (!response.ok) throw new Error('Network response error');
        const data = await response.json();

        if (data.success && data.data) {
          const lanyard = data.data;
          const status = lanyard.discord_status || 'offline';
          const user = lanyard.discord_user || {};
          const username = user.display_name || user.username || 'xinzayr';

          let avatarUrl = '';
          if (user.avatar && user.id) {
            avatarUrl = `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=128`;
          }

          let customStatus = '';
          let mainActivity = null;

          if (lanyard.activities && lanyard.activities.length > 0) {
            const cStat = lanyard.activities.find((a: any) => a.type === 4);
            if (cStat && cStat.state) {
              customStatus = cStat.state;
            }

            mainActivity = lanyard.activities.find((a: any) =>
              a.name !== 'Spotify' && a.type !== 4
            ) || null;
          }

          if (variant === 'simple') {
            this.innerHTML = `
              <div class="flex items-center space-x-2">
                <div class="${sizeClasses[size as keyof typeof sizeClasses]} ${statusColors[status as keyof typeof statusColors]} rounded-full animate-pulse"></div>
                <span class="text-sm text-white/80 font-medium">${username} (${statusLabels[status as keyof typeof statusLabels]})</span>
              </div>
            `;
          } else {
            let activityDetail = customStatus ? customStatus : 'Sin actividad pública';
            if (mainActivity) {
              const typeStr = mainActivity.type === 0 ? 'Jugando a' :
                              mainActivity.type === 1 ? 'Transmitiendo' :
                              mainActivity.type === 2 ? 'Escuchando' :
                              mainActivity.type === 3 ? 'Viendo' : 'Activo en';
              activityDetail = `${typeStr} <strong class="text-cyber-cyan">${mainActivity.name}</strong>`;
            }

            const avatarMarkup = avatarUrl ? `
              <img
                src="${avatarUrl}"
                alt="${username}"
                class="w-10 h-10 rounded-xl object-cover border border-cyber-cyan/30 shadow-md flex-shrink-0"
                loading="lazy"
              />
            ` : `
              <div class="w-10 h-10 bg-gradient-to-br from-cyan-500/20 to-teal-500/20 border border-cyber-cyan/30 rounded-xl flex items-center justify-center text-cyber-cyan font-bold text-sm shadow-md flex-shrink-0">
                ${username.charAt(0).toUpperCase()}
              </div>
            `;

            this.innerHTML = `
              <div class="glass-card rounded-xl p-4 h-full min-h-[140px] flex flex-col justify-between border border-white/10 hover:border-cyber-cyan/30 transition-all duration-300">
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-2">
                    <div class="w-2 h-2 ${statusColors[status as keyof typeof statusColors]} rounded-full animate-pulse"></div>
                    <span class="text-cyber-cyan font-semibold text-xs tracking-wider uppercase">Discord</span>
                  </div>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-white/70 font-mono">${statusLabels[status as keyof typeof statusLabels]}</span>
                </div>

                <div class="flex items-center space-x-3 my-2">
                  ${avatarMarkup}
                  <div class="flex-1 min-w-0">
                    <div class="text-white font-semibold text-sm truncate" title="${username}">
                      ${username}
                    </div>
                    <div class="text-white/60 text-xs truncate" title="${customStatus || 'Discord Status'}">
                      ${customStatus || `@${user.username || 'xinzayr'}`}
                    </div>
                  </div>
                </div>

                <div class="pt-2 border-t border-white/5 text-xs text-white/60 truncate font-mono">
                  ${activityDetail}
                </div>
              </div>
            `;
          }
        }
      } catch (err) {
        if (variant === 'simple') {
          this.innerHTML = `
            <div class="flex items-center space-x-2">
              <div class="${sizeClasses[size as keyof typeof sizeClasses]} bg-gray-400 rounded-full"></div>
              <span class="text-sm text-white/50">Discord (Offline)</span>
            </div>
          `;
        }
      }
    }

    connectedCallback() {
      this.fetchStatus();
      this.pollInterval = window.setInterval(() => this.fetchStatus(), 15000);
    }

    disconnectedCallback() {
      if (this.pollInterval) {
        clearInterval(this.pollInterval);
      }
    }
  }

  customElements.define('discord-status', DiscordStatus);
</script>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
</style>
