---
/**
 * Cookie Consent Banner - Cumplimiento GDPR/ePrivacy
 * Requiere consentimiento explícito antes de cargar scripts de analytics
 */
---

<script is:inline>
  // Gestión de consentimiento
  const CONSENT_KEY = 'xinzayr_cookie_consent';
  const CONSENT_VERSION = '1.0';

  function getConsent() {
    try {
      const stored = localStorage.getItem(CONSENT_KEY);
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed.version === CONSENT_VERSION) {
          return parsed;
        }
      }
    } catch {}
    return null;
  }

  function setConsent(consent) {
    localStorage.setItem(CONSENT_KEY, JSON.stringify({
      ...consent,
      version: CONSENT_VERSION,
      timestamp: new Date().toISOString()
    }));
  }

  function loadAnalytics() {
    // Google Tag Manager
    if (typeof window.dataLayer !== 'undefined') {
      window.dataLayer.push({ event: 'consent_update' });
    }
    // Google Analytics - actualizar consentimiento
    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', {
        'analytics_storage': 'granted',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied'
      });
    }
    // Microsoft Clarity
    if (typeof window.clarity === 'function') {
      window.clarity('consent', true);
    }
  }

  function acceptAll() {
    setConsent({ necessary: true, analytics: true, marketing: false });
    document.getElementById('cookie-banner').style.display = 'none';
    loadAnalytics();
  }

  function acceptNecessary() {
    setConsent({ necessary: true, analytics: false, marketing: false });
    document.getElementById('cookie-banner').style.display = 'none';
  }

  function showPreferences() {
    document.getElementById('cookie-preferences').style.display = 'block';
    document.getElementById('cookie-main').style.display = 'none';
  }

  function savePreferences() {
    const analytics = document.getElementById('pref-analytics').checked;
    const marketing = document.getElementById('pref-marketing').checked;
    setConsent({ necessary: true, analytics, marketing });
    document.getElementById('cookie-banner').style.display = 'none';
    if (analytics) loadAnalytics();
  }

  // Inicialización
  document.addEventListener('DOMContentLoaded', () => {
    const consent = getConsent();
    const banner = document.getElementById('cookie-banner');

    if (!consent && banner) {
      banner.style.display = 'block';
    } else if (consent?.analytics) {
      loadAnalytics();
    }
  });
</script>

<div id="cookie-banner" class="fixed bottom-4 right-4 left-4 md:right-4 md:left-auto md:w-[420px] z-50 glass-card border border-white/10 shadow-2xl animate-slide-up" style="display: none;" role="dialog" aria-label="Consentimiento de cookies" aria-describedby="cookie-description">
  <!-- Vista principal -->
  <div id="cookie-main">
    <div class="p-6">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center bg-blue-500/20 rounded-xl text-blue-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-white font-semibold text-sm">Valoramos tu privacidad</h3>
          <p id="cookie-description" class="text-white/70 text-xs mt-1 leading-relaxed">
            Utilizamos cookies técnicas necesarias para el funcionamiento del sitio y, con tu consentimiento, cookies de analítica para mejorar tu experiencia. No utilizamos cookies de publicidad personalizada.
          </p>
        </div>
        <button
          onclick="document.getElementById('cookie-banner').style.display='none'; acceptNecessary()"
          class="flex-shrink-0 p-1 text-white/50 hover:text-white transition-colors"
          aria-label="Cerrar banner"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="mt-4 flex flex-col sm:flex-row gap-3">
        <button
          onclick="acceptAll()"
          class="flex-1 px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-black"
        >
          Aceptar analítica
        </button>
        <button
          onclick="acceptNecessary()"
          class="flex-1 px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white text-sm font-medium rounded-xl border border-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-black"
        >
          Solo necesarias
        </button>
        <button
          onclick="showPreferences()"
          class="flex-1 px-4 py-2.5 bg-transparent hover:bg-white/5 text-white/70 text-sm font-medium rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-black"
        >
          Preferencias
        </button>
      </div>
    </div>
  </div>

  <!-- Vista de preferencias detalladas -->
  <div id="cookie-preferences" style="display: none;">
    <div class="p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-white font-semibold">Preferencias de cookies</h3>
        <button
          onclick="document.getElementById('cookie-preferences').style.display='none'; document.getElementById('cookie-main').style.display='block';"
          class="text-white/50 hover:text-white text-sm"
        >
          ← Volver
        </button>
      </div>

      <div class="space-y-4">
        <!-- Necesarias (siempre activas) -->
        <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
            <div>
              <p class="text-white text-sm font-medium">Cookies necesarias</p>
              <p class="text-white/60 text-xs">Imprescindibles para el funcionamiento básico del sitio</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" checked disabled class="sr-only peer" aria-label="Cookies necesarias siempre activas">
            <div class="w-11 h-6 bg-green-500 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-green-500/30 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
          </label>
        </div>

        <!-- Analítica -->
        <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
            <div>
              <p class="text-white text-sm font-medium">Cookies de analítica</p>
              <p class="text-white/60 text-xs">Google Analytics y Microsoft Clarity para medir uso del sitio (anonimizado)</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="pref-analytics" class="sr-only peer" aria-label="Activar cookies de analítica">
            <div class="w-11 h-6 bg-white/10 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-white/20 peer-checked:bg-blue-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
          </label>
        </div>

        <!-- Marketing (no usadas) -->
        <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5 opacity-50">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-gray-500 rounded-full"></div>
            <div>
              <p class="text-white text-sm font-medium">Cookies de marketing</p>
              <p class="text-white/60 text-xs">No utilizadas en este sitio</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="pref-marketing" disabled class="sr-only peer" aria-label="Cookies de marketing no usadas">
            <div class="w-11 h-6 bg-white/10 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-white/20 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
          </label>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-white/10">
        <button
          onclick="savePreferences()"
          class="w-full px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-black"
        >
          Guardar preferencias
        </button>
      </div>
    </div>
  </div>

  <style>
    @keyframes slide-up {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-slide-up { animation: slide-up 0.3s ease-out; }
  </style>
</div>