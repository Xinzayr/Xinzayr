---
import { API_CONFIG } from '../consts';

interface Props {
  username?: string;
}

const { username: propUsername } = Astro.props;

// Obtener username y token de entorno
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || API_CONFIG.github.token;
const rawUsername = propUsername || import.meta.env.GITHUB_USERNAME || API_CONFIG.github.username || 'xinzayr';
// Normalizar username eliminando acentos/caracteres especiales
const username = rawUsername.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

interface Day {
  date: string;
  contributionCount: number;
  color: string;
  weekday: number;
  level: number;
}

interface Week {
  contributionDays: Day[];
}

let totalContributions = 0;
let weeks: Week[] = [];
let maxContributionsInSingleDay = 0;
let maxDayDate = '';
let activeDaysCount = 0;
let isLoaded = false;
let isFallback = false;

// 1. Intentar obtener datos mediante GitHub GraphQL API
if (GITHUB_TOKEN && username) {
  try {
    const query = `query {
      user(login: "${username}") {
        contributionsCollection {
          contributionCalendar {
            totalContributions
            weeks {
              contributionDays {
                color
                contributionCount
                date
                weekday
              }
            }
          }
        }
      }
    }`;

    const response = await fetch('https://api.github.com/graphql', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${GITHUB_TOKEN}`,
        'Content-Type': 'application/json',
        'User-Agent': 'xinzayr-portfolio'
      },
      body: JSON.stringify({ query })
    });

    if (response.ok) {
      const data = await response.json();
      const calendar = data?.data?.user?.contributionsCollection?.contributionCalendar;
      if (calendar) {
        totalContributions = calendar.totalContributions;
        weeks = calendar.weeks.map((w: any) => ({
          contributionDays: w.contributionDays.map((d: any) => {
            const count = d.contributionCount;
            let level = 0;
            if (count > 0 && count <= 3) level = 1;
            else if (count > 3 && count <= 9) level = 2;
            else if (count > 9 && count <= 19) level = 3;
            else if (count > 19) level = 4;

            if (count > maxContributionsInSingleDay) {
              maxContributionsInSingleDay = count;
              maxDayDate = d.date;
            }
            if (count > 0) activeDaysCount++;

            return {
              date: d.date,
              contributionCount: count,
              color: d.color,
              weekday: d.weekday,
              level
            };
          })
        }));
        isLoaded = true;
      }
    }
  } catch (err) {
    console.warn('Error fetching GitHub GraphQL contributions:', err);
  }
}

// 2. Fallback: Parsear la página pública de contribuciones si GraphQL no estuvo disponible
if (!isLoaded && username) {
  try {
    const htmlRes = await fetch(`https://github.com/users/${username}/contributions`, {
      headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' }
    });

    if (htmlRes.ok) {
      const html = await htmlRes.text();
      // Extraer total de contribuciones
      const matchTotal = html.match(/([\d,]+)\s+contributions\s+in\s+the\s+last\s+year/i);
      if (matchTotal) {
        totalContributions = parseInt(matchTotal[1].replace(/,/g, ''), 10);
      }

      // Extraer días del calendario HTML
      const dayMatches = [...html.matchAll(/data-date="([^"]+)"[^>]*data-level="([0-4])"/g)];
      if (dayMatches.length > 0) {
        const daysList: Day[] = dayMatches.map((m) => {
          const dateStr = m[1];
          const level = parseInt(m[2], 10);
          const approxCount = level === 0 ? 0 : level === 1 ? 2 : level === 2 ? 5 : level === 3 ? 12 : 24;
          if (level > 0) activeDaysCount++;
          return {
            date: dateStr,
            contributionCount: approxCount,
            color: level === 0 ? '#ebedf0' : level === 1 ? '#9be9a8' : level === 2 ? '#40c463' : level === 3 ? '#30a14e' : '#216e39',
            weekday: new Date(dateStr).getUTCDay(),
            level
          };
        });

        // Agrupar los días por semanas (de 7 en 7)
        weeks = [];
        for (let i = 0; i < daysList.length; i += 7) {
          weeks.push({
            contributionDays: daysList.slice(i, i + 7)
          });
        }
        isLoaded = true;
        isFallback = true;
      }
    }
  } catch (err) {
    console.warn('Fallback scrape contributions failed:', err);
  }
}

// 3. Fallback de respaldo mock si no hay conexión
if (!isLoaded) {
  weeks = Array.from({ length: 52 }, (_, weekIdx) => ({
    contributionDays: Array.from({ length: 7 }, (_, dayIdx) => {
      const d = new Date();
      d.setDate(d.getDate() - (52 - weekIdx) * 7 + dayIdx);
      return {
        date: d.toISOString().split('T')[0],
        contributionCount: 0,
        color: '#ebedf0',
        weekday: dayIdx,
        level: 0
      };
    })
  }));
  totalContributions = 0;
  isLoaded = true;
  isFallback = true;
}

// Calcular etiquetas de meses para las 53 semanas
const monthLabels: { label: string; colIndex: number }[] = [];
let lastMonth = -1;

weeks.forEach((w, wIdx) => {
  const firstDayOfWeek = w.contributionDays[0];
  if (firstDayOfWeek) {
    const m = new Date(firstDayOfWeek.date).getUTCMonth();
    if (m !== lastMonth) {
      lastMonth = m;
      const monthNames = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
      monthLabels.push({ label: monthNames[m], colIndex: wIdx });
    }
  }
});

// Función formateadora de fechas en español
function formatDateSpanish(dateStr: string): string {
  if (!dateStr) return '';
  const parts = dateStr.split('-');
  if (parts.length !== 3) return dateStr;
  const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
  return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<div class="glass rounded-2xl p-6 lg:p-8 border border-white/10 shadow-2xl relative overflow-hidden group">
  <!-- Fondo de brillo cibernético -->
  <div class="absolute -top-24 -right-24 w-72 h-72 bg-cyber-green/10 rounded-full blur-3xl pointer-events-none group-hover:bg-cyber-green/20 transition-all duration-500"></div>

  <!-- Header del gráfico de contribuciones -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-white/10">
    <div class="space-y-1">
      <div class="flex items-center space-x-3">
        <div class="p-2 bg-cyber-green/10 rounded-lg text-cyber-green border border-cyber-green/20">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.30 3.297-1.30.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
          <span class="text-cyber-green font-mono">{totalContributions}</span> contribuciones en el último año
        </h3>
      </div>
      <p class="text-xs sm:text-sm text-white/60">
        Actividad pública sincronizada en tiempo real directamente desde GitHub (@{username})
      </p>
    </div>

    <!-- Badges Estadísticas Rápidas -->
    <div class="flex flex-wrap items-center gap-2">
      <div class="px-3 py-1.5 bg-white/5 border border-white/10 rounded-lg text-xs flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full bg-cyber-green animate-pulse"></span>
        <span class="text-white/70">Días activos:</span>
        <span class="text-cyber-green font-bold font-mono">{activeDaysCount}</span>
      </div>
      {maxContributionsInSingleDay > 0 && (
        <div class="px-3 py-1.5 bg-white/5 border border-white/10 rounded-lg text-xs flex items-center space-x-2">
          <span class="text-white/70">Día récord:</span>
          <span class="text-cyber-cyan font-bold font-mono">{maxContributionsInSingleDay}</span>
          <span class="text-white/40 text-[10px]">({formatDateSpanish(maxDayDate)})</span>
        </div>
      )}
    </div>
  </div>

  <!-- Matriz de Cuadritos de GitHub (Graph Grid Container) -->
  <div class="overflow-x-auto pb-4 custom-scrollbar">
    <div class="min-w-[760px] flex flex-col space-y-2">
      
      <!-- Fila de Etiquetas de Meses -->
      <div class="flex items-center text-xs text-white/50 font-mono pl-8 h-4">
        {weeks.map((_, idx) => {
          const monthObj = monthLabels.find(m => m.colIndex === idx);
          return (
            <div class="w-3.5 text-[11px] select-none">
              {monthObj ? monthObj.label : ''}
            </div>
          );
        })}
      </div>

      <!-- Matriz Principal: Días de la semana + Columnas de Semanas -->
      <div class="flex space-x-2">
        <!-- Columna de Etiquetas de Días (Lun, Mié, Vie) -->
        <div class="flex flex-col justify-between text-[10px] text-white/40 font-mono py-0.5 select-none w-6 shrink-0">
          <span>Dom</span>
          <span>Lun</span>
          <span>Mar</span>
          <span>Mié</span>
          <span>Jue</span>
          <span>Vie</span>
          <span>Sáb</span>
        </div>

        <!-- 53 Columnas de Semanas con Cuadritos -->
        <div class="flex space-x-1 flex-1 justify-between">
          {weeks.map((week) => (
            <div class="flex flex-col space-y-1">
              {week.contributionDays.map((day) => {
                const tooltipText = day.contributionCount > 0
                  ? `${day.contributionCount} contribución${day.contributionCount > 1 ? 'es' : ''} el ${formatDateSpanish(day.date)}`
                  : `Sin contribuciones el ${formatDateSpanish(day.date)}`;

                return (
                  <div
                    class={`w-3 h-3 rounded-sm transition-all duration-200 cursor-pointer relative group/sq ${
                      day.level === 0 ? 'bg-white/5 border border-white/10 hover:border-white/40' :
                      day.level === 1 ? 'bg-emerald-900/90 border border-emerald-700/50 shadow-sm shadow-emerald-900/50 hover:scale-125' :
                      day.level === 2 ? 'bg-emerald-600 border border-emerald-500/70 shadow-sm shadow-emerald-600/50 hover:scale-125' :
                      day.level === 3 ? 'bg-emerald-400 border border-emerald-300 shadow-md shadow-emerald-400/60 hover:scale-125' :
                      'bg-cyber-green border border-green-200 shadow-lg shadow-cyber-green/80 animate-pulse-slow hover:scale-125'
                    }`}
                    title={tooltipText}
                  >
                    <!-- Custom Floating Tooltip -->
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/sq:block z-30 pointer-events-none">
                      <div class="bg-black/90 text-white text-[11px] font-sans px-2.5 py-1 rounded-md shadow-xl border border-white/20 whitespace-nowrap">
                        {tooltipText}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Pie del Gráfico: Leyenda de Colores & Enlace GitHub -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 mt-2 border-t border-white/10 text-xs">
    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noopener noreferrer"
      class="text-white/60 hover:text-cyber-cyan transition-colors flex items-center space-x-1.5"
    >
      <span>Aprende cómo se cuentan las contribuciones</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    </a>

    <!-- Leyenda Menos -> Más -->
    <div class="flex items-center space-x-2 text-white/60">
      <span>Menos</span>
      <div class="flex space-x-1">
        <div class="w-3 h-3 rounded-sm bg-white/5 border border-white/10" title="0 contribuciones"></div>
        <div class="w-3 h-3 rounded-sm bg-emerald-900/90 border border-emerald-700/50" title="1-3 contribuciones"></div>
        <div class="w-3 h-3 rounded-sm bg-emerald-600 border border-emerald-500/70" title="4-9 contribuciones"></div>
        <div class="w-3 h-3 rounded-sm bg-emerald-400 border border-emerald-300" title="10-19 contribuciones"></div>
        <div class="w-3 h-3 rounded-sm bg-cyber-green border border-green-200 shadow-sm shadow-cyber-green/80" title="20+ contribuciones"></div>
      </div>
      <span>Más</span>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(74, 222, 128, 0.3);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(74, 222, 128, 0.6);
  }
</style>
