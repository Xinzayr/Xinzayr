---
// Componente para mostrar repositorios de GitHub
// Conecta con GitHub API usando el token configurado
interface Props {
  variant?: 'featured' | 'grid' | 'list';
  limit?: number;
  showPrivate?: boolean;
}

const { variant = 'grid', limit = 6, showPrivate = false } = Astro.props;

// Obtener configuración desde variables de entorno
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const GITHUB_USERNAME = import.meta.env.GITHUB_USERNAME || 'xinzayr';

let githubRepos: any[] = [];

// Solo obtener datos si el token está disponible (datos reales únicamente)
if (GITHUB_TOKEN && GITHUB_USERNAME) {
  try {
    const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=50`, {
      headers: {
        'Authorization': `Bearer ${GITHUB_TOKEN}`,
        'Accept': 'application/vnd.github.v3+json',
        'User-Agent': 'xinzayr-portfolio'
      }
    });

    if (response.ok) {
      const repos = await response.json();
      githubRepos = repos.map((repo: any) => ({
        id: repo.id,
        name: repo.name,
        full_name: repo.full_name,
        description: repo.description || 'No description available',
        html_url: repo.html_url,
        homepage: repo.homepage,
        topics: repo.topics || [],
        language: repo.language,
        stargazers_count: repo.stargazers_count,
        forks_count: repo.forks_count,
        updated_at: repo.updated_at,
        private: repo.private,
        archived: repo.archived
      }));
    }
  } catch (error) {
    console.warn('Error fetching GitHub repositories:', error);
    // No usar datos de ejemplo - mantener array vacío si hay error
    githubRepos = [];
  }
} else {
  console.warn('GitHub token not configured - repositories will not be displayed');
}

const filteredRepos = githubRepos
  .filter(repo => showPrivate || !repo.private)
  .filter(repo => !repo.archived)
  .slice(0, limit);

const languageColors: Record<string, string> = {
  'TypeScript': '#3178c6',
  'JavaScript': '#f7df1e',
  'Python': '#3776ab',
  'Dart': '#0175c2',
  'Solidity': '#363636',
  'HTML': '#e34f26',
  'CSS': '#1572b6',
  'Java': '#f89820',
  'C#': '#239120',
  'C++': '#00599c',
  'Go': '#00add8',
  'Rust': '#000000',
  'PHP': '#777bb4',
  'Ruby': '#cc342d',
  'Swift': '#fa7343',
  'Kotlin': '#7f52ff'
};

function getTimeAgo(dateString: string) {
  const date = new Date(dateString);
  const now = new Date();
  const diffTime = Math.abs(now.getTime() - date.getTime());
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

  if (diffDays === 1) return 'hace 1 día';
  if (diffDays < 7) return `hace ${diffDays} días`;
  if (diffDays < 30) return `hace ${Math.ceil(diffDays / 7)} semanas`;
  return `hace ${Math.ceil(diffDays / 30)} meses`;
}
---

<div class="github-repos">
  {filteredRepos.length === 0 ? (
    <!-- Mensaje cuando no hay datos -->
    <div class="text-center py-12">
      <div class="glass rounded-lg p-8 max-w-md mx-auto">
        <svg class="w-12 h-12 text-white/40 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <h3 class="text-white font-medium mb-2">Repositorios no disponibles</h3>
        <p class="text-white/60 text-sm">
          Los repositorios de GitHub se mostrarán cuando las variables de entorno estén configuradas en producción.
        </p>
      </div>
    </div>
  ) : variant === 'featured' ? (
    <!-- Vista destacada para página principal -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {filteredRepos.map((repo) => (
        <a
          href={repo.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="block glass rounded-xl p-6 glass-hover group"
        >
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <h3 class="text-white font-semibold text-lg group-hover:text-blue-400 transition-colors">
                {repo.name}
              </h3>
              <p class="text-white/60 text-sm mt-1 line-clamp-2">
                {repo.description}
              </p>
            </div>
            <div class="ml-4">
              <svg class="w-5 h-5 text-white/40 group-hover:text-white/60 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
          </div>

          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4 text-xs text-white/50">
              {repo.language && (
                <div class="flex items-center space-x-1">
                  <div
                    class="w-2 h-2 rounded-full"
                    style={`background-color: ${languageColors[repo.language] || '#888'}`}
                  ></div>
                  <span>{repo.language}</span>
                </div>
              )}
              <div class="flex items-center space-x-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span>{repo.stargazers_count}</span>
              </div>
              <div class="flex items-center space-x-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                <span>{repo.forks_count}</span>
              </div>
            </div>
            <span class="text-xs text-white/40">
              {getTimeAgo(repo.updated_at)}
            </span>
          </div>

          {repo.topics && repo.topics.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-3">
              {repo.topics.slice(0, 3).map((topic: string) => (
                <span class="px-2 py-1 bg-white/10 text-white/70 text-xs rounded-md">
                  {topic}
                </span>
              ))}
              {repo.topics.length > 3 && (
                <span class="px-2 py-1 bg-white/10 text-white/70 text-xs rounded-md">
                  +{repo.topics.length - 3}
                </span>
              )}
            </div>
          )}
        </a>
      ))}
    </div>
  ) : variant === 'list' ? (
    <!-- Vista de lista para página de proyectos -->
    <div class="space-y-4">
      {filteredRepos.map((repo) => (
        <a
          href={repo.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="block glass rounded-lg p-4 glass-hover group"
        >
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <div class="flex items-center space-x-2">
                <h3 class="text-white font-medium group-hover:text-blue-400 transition-colors">
                  {repo.name}
                </h3>
                {repo.homepage && (
                  <a
                    href={repo.homepage}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-400 hover:text-blue-300"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                )}
              </div>
              <p class="text-white/60 text-sm mt-1">
                {repo.description}
              </p>
            </div>
            <div class="flex items-center space-x-4 text-xs text-white/50 ml-4">
              {repo.language && (
                <div class="flex items-center space-x-1">
                  <div
                    class="w-2 h-2 rounded-full"
                    style={`background-color: ${languageColors[repo.language] || '#888'}`}
                  ></div>
                  <span>{repo.language}</span>
                </div>
              )}
              <span>{repo.stargazers_count} ⭐</span>
              <span>{getTimeAgo(repo.updated_at)}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <!-- Vista de grid por defecto -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {filteredRepos.map((repo) => (
        <a
          href={repo.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="block glass rounded-lg p-4 glass-hover group"
        >
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-white font-medium group-hover:text-blue-400 transition-colors flex-1">
              {repo.name}
            </h3>
            <svg class="w-4 h-4 text-white/40 group-hover:text-white/60 transition-colors ml-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <p class="text-white/60 text-sm mb-3 line-clamp-2">
            {repo.description}
          </p>
          <div class="flex items-center justify-between text-xs text-white/50">
            <div class="flex items-center space-x-3">
              {repo.language && (
                <div class="flex items-center space-x-1">
                  <div
                    class="w-2 h-2 rounded-full"
                    style={`background-color: ${languageColors[repo.language] || '#888'}`}
                  ></div>
                  <span>{repo.language}</span>
                </div>
              )}
              <span>{repo.stargazers_count} ⭐</span>
            </div>
            <span>{getTimeAgo(repo.updated_at)}</span>
          </div>
        </a>
      ))}
    </div>
  )}
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
