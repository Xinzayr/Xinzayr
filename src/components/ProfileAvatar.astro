---
// Componente para el avatar con gradiente mejorado
interface Props {
  imageUrl?: string;
  username?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showGradient?: boolean;
  showFloatingElements?: boolean;
}

const {
  imageUrl,
  username,
  size = 'lg',
  showGradient = true,
  showFloatingElements = true
} = Astro.props;

// Obtener configuración desde variables de entorno
const profileUsername = username || import.meta.env.GITHUB_USERNAME || 'xinzayr';
const profileImageUrl = imageUrl || import.meta.env.PROFILE_AVATAR_URL || `https://github.com/${profileUsername}.png?size=400`;

const sizeClasses = {
  sm: 'w-12 h-12',
  md: 'w-24 h-24',
  lg: 'w-64 h-64 lg:w-80 lg:h-80',
  xl: 'w-96 h-96'
};

const fallbackSvg = `data:image/svg+xml;base64,${btoa(`
  <svg width="400" height="400" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect width="400" height="400" fill="#374151"/>
    <text x="200" y="230" font-family="Arial" font-size="160" font-weight="bold" fill="white" text-anchor="middle">
      ${profileUsername.charAt(0).toUpperCase()}
    </text>
  </svg>
`)}`;
---

<div class="relative">
  <div class={`relative ${sizeClasses[size]} mx-auto`}>
    {showGradient ? (
      <!-- Avatar con gradiente -->
      <div class="w-full h-full rounded-full bg-gradient-to-br from-blue-500 via-purple-600 to-pink-500 p-1 shadow-2xl">
        <div class="w-full h-full rounded-full bg-black flex items-center justify-center overflow-hidden">
          <img
            src={profileImageUrl}
            alt={profileUsername}
            class="w-full h-full rounded-full object-cover transition-transform duration-300 hover:scale-105"
            loading="lazy"
            onerror={`this.src='${fallbackSvg}'`}
          />
        </div>
      </div>
    ) : (
      <!-- Avatar simple -->
      <div class="w-full h-full rounded-full overflow-hidden shadow-xl">
        <img
          src={profileImageUrl}
          alt={profileUsername}
          class="w-full h-full rounded-full object-cover transition-transform duration-300 hover:scale-105"
          loading="lazy"
          onerror={`this.src='${fallbackSvg}'`}
        />
      </div>
    )}

    {showFloatingElements && size === 'lg' && (
      <!-- Elementos flotantes animados -->
      <Fragment>
        <div class="absolute -top-4 -right-4 w-8 h-8 bg-blue-500 rounded-lg floating shadow-lg" style="animation-delay: 0s;"></div>
        <div class="absolute -bottom-4 -left-4 w-6 h-6 bg-purple-500 rounded-lg floating shadow-lg" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/2 -left-8 w-4 h-4 bg-pink-500 rounded-full floating shadow-lg" style="animation-delay: 4s;"></div>
        <div class="absolute top-1/4 -right-6 w-3 h-3 bg-green-400 rounded-full floating shadow-lg" style="animation-delay: 1s;"></div>
        <div class="absolute bottom-1/4 -left-6 w-5 h-5 bg-yellow-400 rounded-lg floating shadow-lg" style="animation-delay: 3s;"></div>
      </Fragment>
    )}
  </div>
</div>

<style>
  @keyframes floating {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-10px) rotate(3deg);
    }
    50% {
      transform: translateY(-20px) rotate(0deg);
    }
    75% {
      transform: translateY(-10px) rotate(-3deg);
    }
  }

  .floating {
    animation: floating 6s ease-in-out infinite;
  }

  /* Mejoras de sombra para el gradiente */
  .shadow-2xl {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25),
                0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  /* Efecto hover adicional */
  .relative:hover .floating {
    animation-play-state: paused;
    transform: scale(1.1);
    transition: transform 0.3s ease;
  }
</style>
