---
// Componente para mostrar la música actual de Spotify mediante Lanyard API con Fallback directo a Spotify Web API
interface Props {
  variant?: 'simple' | 'detailed';
  showWhenNotPlaying?: boolean;
}

const { variant = 'simple', showWhenNotPlaying = false } = Astro.props;

const DISCORD_USER_ID =
  import.meta.env.PUBLIC_DISCORD_USER_ID ||
  import.meta.env.DISCORD_USER_ID ||
  '985292430758793308';

const SPOTIFY_CLIENT_ID =
  import.meta.env.PUBLIC_SPOTIFY_CLIENT_ID ||
  import.meta.env.SPOTIFY_CLIENT_ID ||
  '09273698406c49eb98057922bd22df22';

const SPOTIFY_CLIENT_SECRET =
  import.meta.env.PUBLIC_SPOTIFY_CLIENT_SECRET ||
  import.meta.env.SPOTIFY_CLIENT_SECRET ||
  'c66ea14a565d4909ba9e8e5e17566327';

const SPOTIFY_REFRESH_TOKEN =
  import.meta.env.PUBLIC_SPOTIFY_REFRESH_TOKEN ||
  import.meta.env.SPOTIFY_REFRESH_TOKEN ||
  'AQB927vuNLcG7H9BZXi6JVJaaDzstIyLy48MId-GZyuEci_sSIEHYNW2n-Sb32DXdSiFakpJ7kYSLwAycq5QoRpgbtNsAdubLfiF88I1dmdqfyPEMRv2fkFaJ8y2N5EQLes';
---

<spotify-status 
  data-userid={DISCORD_USER_ID}
  data-clientid={SPOTIFY_CLIENT_ID}
  data-clientsecret={SPOTIFY_CLIENT_SECRET}
  data-refreshtoken={SPOTIFY_REFRESH_TOKEN}
  data-variant={variant} 
  data-show-always={showWhenNotPlaying.toString()}
  class="h-full block"
>
  {variant === 'simple' ? (
    <div class="flex items-center space-x-2 min-w-[100px]">
      <div class="w-2 h-2 bg-gray-400 rounded-full animate-pulse"></div>
      <span class="text-sm text-white/50">Spotify...</span>
    </div>
  ) : (
    showWhenNotPlaying ? (
      <div class="glass-card rounded-xl p-4 h-full min-h-[140px] flex flex-col justify-between border border-white/10 hover:border-cyber-green/30 transition-all duration-300">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="w-2 h-2 bg-cyber-green rounded-full animate-pulse"></div>
            <span class="text-cyber-green font-semibold text-xs tracking-wider uppercase">Spotify</span>
          </div>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-white/60 font-mono">Comprobando...</span>
        </div>
        <div class="flex items-center space-x-3 my-2">
          <div class="w-10 h-10 bg-white/10 rounded-xl animate-pulse flex-shrink-0"></div>
          <div class="space-y-1.5 flex-1 min-w-0">
            <div class="w-24 h-3 bg-white/10 rounded animate-pulse"></div>
            <div class="w-16 h-2.5 bg-white/10 rounded animate-pulse"></div>
          </div>
        </div>
        <div class="pt-2 border-t border-white/5">
          <span class="text-white/40 text-xs font-mono">Obteniendo reproducción...</span>
        </div>
      </div>
    ) : null
  )}
</spotify-status>

<script>
  let cachedAccessToken: string | null = null;
  let tokenExpiresAt = 0;

  async function getLiveAccessToken(clientId: string, clientSecret: string, refreshToken: string): Promise<string | null> {
    if (cachedAccessToken && Date.now() < tokenExpiresAt) {
      return cachedAccessToken;
    }
    if (!clientId || !clientSecret || !refreshToken) return null;

    try {
      const basic = btoa(`${clientId}:${clientSecret}`);
      const response = await fetch('https://accounts.spotify.com/api/token', {
        method: 'POST',
        headers: {
          'Authorization': `Basic ${basic}`,
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
          grant_type: 'refresh_token',
          refresh_token: refreshToken,
        }),
      });

      if (!response.ok) return null;
      const data = await response.json();
      if (data.access_token) {
        cachedAccessToken = data.access_token;
        tokenExpiresAt = Date.now() + (data.expires_in - 60) * 1000;
        return cachedAccessToken;
      }
    } catch (e) {
      console.error('Error obteniendo token de Spotify:', e);
    }
    return null;
  }

  class SpotifyStatus extends HTMLElement {
    private timer: number | null = null;
    private pollInterval: number | null = null;

    constructor() {
      super();
    }

    formatDuration(ms: number) {
      if (isNaN(ms) || ms < 0) return '0:00';
      const minutes = Math.floor(ms / 60000);
      const seconds = Math.floor((ms % 60000) / 1000);
      return `${minutes}:${seconds.toString().padStart(2, '0')}`;
    }

    async fetchSpotifyData() {
      const userId = this.dataset.userid;
      const clientId = this.dataset.clientid || '';
      const clientSecret = this.dataset.clientsecret || '';
      const refreshToken = this.dataset.refreshtoken || '';
      const variant = this.dataset.variant;
      const showAlways = this.dataset.showAlways === 'true';

      try {
        let spotifyData: any = null;

        // 1. Intentar primero con Lanyard API (Presencia en tiempo real de Discord)
        if (userId) {
          try {
            const lanyardRes = await fetch(`https://api.lanyard.rest/v1/users/${userId}`);
            if (lanyardRes.ok) {
              const lData = await lanyardRes.json();
              if (lData.success && lData.data && lData.data.spotify) {
                const s = lData.data.spotify;
                spotifyData = {
                  isPlaying: true,
                  title: s.song,
                  artist: s.artist,
                  album: s.album,
                  albumImageUrl: s.album_art_url,
                  songUrl: `https://open.spotify.com/track/${s.track_id}`,
                  start: s.timestamps?.start,
                  end: s.timestamps?.end,
                  durationMs: s.timestamps ? s.timestamps.end - s.timestamps.start : 0,
                  source: 'lanyard'
                };
              }
            }
          } catch (e) {}
        }

        // 2. Si Lanyard no tiene reproducción activa, consultar directamente la API oficial de Spotify desde el cliente en vivo
        if (!spotifyData && clientId && clientSecret && refreshToken) {
          try {
            const accessToken = await getLiveAccessToken(clientId, clientSecret, refreshToken);
            if (accessToken) {
              const nowRes = await fetch('https://api.spotify.com/v1/me/player/currently-playing', {
                headers: { Authorization: `Bearer ${accessToken}` },
              });

              if (nowRes.status === 200) {
                const song = await nowRes.json();
                if (song && song.item) {
                  spotifyData = {
                    isPlaying: song.is_playing,
                    title: song.item.name,
                    artist: song.item.artists?.map((a: any) => a.name).join(', ') || 'Desconocido',
                    album: song.item.album?.name || '',
                    albumImageUrl: song.item.album?.images?.[0]?.url || null,
                    songUrl: song.item.external_urls?.spotify || '',
                    progressMs: song.progress_ms || 0,
                    durationMs: song.item.duration_ms || 100000,
                    source: 'direct-live'
                  };
                }
              }

              // Si la música está pausada o inactiva, obtener el último tema reproducido recientemente
              if (!spotifyData || nowRes.status === 204) {
                const recentRes = await fetch('https://api.spotify.com/v1/me/player/recently-played?limit=1', {
                  headers: { Authorization: `Bearer ${accessToken}` },
                });
                if (recentRes.ok) {
                  const recentData = await recentRes.json();
                  const lastItem = recentData.items?.[0]?.track;
                  if (lastItem) {
                    spotifyData = {
                      isPlaying: false,
                      title: lastItem.name,
                      artist: lastItem.artists?.map((a: any) => a.name).join(', ') || 'Desconocido',
                      album: lastItem.album?.name || '',
                      albumImageUrl: lastItem.album?.images?.[0]?.url || null,
                      songUrl: lastItem.external_urls?.spotify || '',
                      progressMs: 0,
                      durationMs: lastItem.duration_ms || 100000,
                      source: 'direct-recent'
                    };
                  }
                }
              }
            }
          } catch (e) {
            console.error('Error consultando Spotify API cliente:', e);
          }
        }

        // 3. Fallback final: /api/spotify.json
        if (!spotifyData) {
          try {
            const directRes = await fetch(`/api/spotify.json?t=${Date.now()}`);
            if (directRes.ok) {
              const dData = await directRes.json();
              if (dData.title) {
                spotifyData = {
                  isPlaying: dData.isPlaying,
                  title: dData.title,
                  artist: dData.artist,
                  album: dData.album,
                  albumImageUrl: dData.albumImageUrl,
                  songUrl: dData.songUrl,
                  progressMs: dData.progressMs || 0,
                  durationMs: dData.durationMs || 100000,
                  source: 'api-file'
                };
              }
            }
          } catch (e) {}
        }
        
        if (this.timer) {
          clearInterval(this.timer);
          this.timer = null;
        }

        if (spotifyData) {
          const track = spotifyData;

          const renderPlaying = () => {
            let progressMs = 0;
            let progressPercent = 0;

            if (track.source === 'lanyard' && track.start) {
              const now = new Date().getTime();
              progressMs = Math.max(0, now - track.start);
              progressPercent = Math.min(100, (progressMs / track.durationMs) * 100);
            } else if (track.progressMs !== undefined && track.durationMs) {
              progressMs = track.progressMs;
              progressPercent = Math.min(100, (progressMs / track.durationMs) * 100);
            }

            if (variant === 'simple') {
              this.innerHTML = `
                <div class="flex items-center space-x-2">
                  <div class="w-2 h-2 ${track.isPlaying ? 'bg-cyber-green animate-pulse' : 'bg-gray-400'} rounded-full"></div>
                  <span class="text-sm text-white/80 font-medium truncate">${track.title} - ${track.artist}</span>
                </div>
              `;
            } else {
              this.innerHTML = `
                <div class="glass-card rounded-xl p-4 h-full min-h-[140px] flex flex-col justify-between border border-white/10 hover:border-cyber-green/30 transition-all duration-300">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                      <div class="w-2 h-2 ${track.isPlaying ? 'bg-cyber-green animate-pulse' : 'bg-gray-400'} rounded-full"></div>
                      <span class="text-cyber-green font-semibold text-xs tracking-wider uppercase">Spotify</span>
                    </div>
                    ${track.songUrl ? `
                      <a href="${track.songUrl}" target="_blank" rel="noopener noreferrer" class="text-[10px] px-2 py-0.5 rounded-full ${track.isPlaying ? 'bg-cyber-green/20 text-cyber-green hover:bg-cyber-green/30' : 'bg-white/10 text-white/60'} transition-colors font-mono flex items-center space-x-1">
                        <span>${track.isPlaying ? 'En vivo' : 'Última'}</span>
                        <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                        </svg>
                      </a>
                    ` : ''}
                  </div>

                  <div class="flex items-center space-x-3 my-2">
                    ${track.albumImageUrl ? `
                      <div class="relative flex-shrink-0">
                        <img
                          src="${track.albumImageUrl}"
                          alt="${track.album || 'Album'}"
                          class="w-10 h-10 rounded-xl object-cover border border-cyber-green/30 shadow-md"
                          loading="lazy"
                        />
                      </div>
                    ` : ''}
                    <div class="flex-1 min-w-0">
                      <div class="text-white font-semibold text-sm truncate" title="${track.title}">
                        ${track.title}
                      </div>
                      <div class="text-white/60 text-xs truncate" title="${track.artist}">
                        ${track.artist}
                      </div>
                    </div>
                  </div>

                  <div class="pt-2 border-t border-white/5 flex items-center space-x-2">
                    <div class="flex-1 bg-white/10 rounded-full h-1">
                      <div
                        class="bg-cyber-green h-1 rounded-full transition-all duration-1000 ease-linear"
                        style="width: ${progressPercent > 0 ? progressPercent : 100}%"
                      ></div>
                    </div>
                    <span class="text-white/40 text-[10px] font-mono w-7 text-right">
                      ${this.formatDuration(progressMs)}
                    </span>
                  </div>
                </div>
              `;
            }
          };

          renderPlaying();
          if (variant === 'detailed' && track.source === 'lanyard') {
            this.timer = window.setInterval(renderPlaying, 1000);
          }
        } else {
          // Sin música
          if (variant === 'simple') {
            this.innerHTML = `
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
                <span class="text-sm text-white/50">Spotify (Inactivo)</span>
              </div>
            `;
          } else if (showAlways) {
            this.innerHTML = `
              <div class="glass-card rounded-xl p-4 h-full min-h-[140px] flex flex-col justify-between border border-white/10 hover:border-cyber-green/30 transition-all duration-300">
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-2">
                    <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
                    <span class="text-cyber-green font-semibold text-xs tracking-wider uppercase">Spotify</span>
                  </div>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-white/50 font-mono">Inactivo</span>
                </div>

                <div class="flex items-center space-x-3 my-2">
                  <div class="w-10 h-10 bg-cyber-green/10 border border-cyber-green/20 rounded-xl flex items-center justify-center text-cyber-green flex-shrink-0">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-white/80 font-semibold text-sm truncate">Sin música activa</div>
                    <div class="text-white/50 text-xs truncate">Spotify Offline</div>
                  </div>
                </div>

                <div class="pt-2 border-t border-white/5 text-xs text-white/40 truncate font-mono">
                  Pausa o sin reproducción
                </div>
              </div>
            `;
          } else {
            this.innerHTML = '';
          }
        }
      } catch (err) {
        if (variant === 'simple') {
          this.innerHTML = `
            <div class="flex items-center space-x-2">
              <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
              <span class="text-sm text-white/50">Spotify (Offline)</span>
            </div>
          `;
        }
      }
    }

    connectedCallback() {
      this.fetchSpotifyData();
      this.pollInterval = window.setInterval(() => this.fetchSpotifyData(), 8000);
    }

    disconnectedCallback() {
      if (this.timer) clearInterval(this.timer);
      if (this.pollInterval) clearInterval(this.pollInterval);
    }
  }

  if (!customElements.get('spotify-status')) {
    customElements.define('spotify-status', SpotifyStatus);
  }
</script>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
</style>
