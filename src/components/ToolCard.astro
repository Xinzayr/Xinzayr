---
export interface Props {
	title: string;
	shortDescription: string;
	tags: string[];
	category: string;
	featured?: boolean;
	href: string;
}

const { title, shortDescription, tags, category, featured = false, href } = Astro.props;
---

<article class={`glass rounded-xl p-6 glass-hover transition-all duration-300 group ${featured ? 'ring-2 ring-purple-500/30 glow' : ''}`}>
	<div class="space-y-4">
		<!-- Header -->
		<div class="flex items-center justify-between">
			<div class="flex items-center space-x-2">
				<div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center">
					<svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
					</svg>
				</div>
				<span class="px-2 py-1 text-xs bg-purple-500/20 text-purple-300 rounded-md font-medium">
					{category}
				</span>
			</div>

			{featured && (
				<span class="px-2 py-1 text-xs font-medium bg-purple-500 text-white rounded-full">
					Destacada
				</span>
			)}
		</div>

		<!-- Content -->
		<div class="space-y-3">
			<h3 class="text-lg font-semibold text-white group-hover:text-purple-400 transition-colors">
				<a href={href} class="block">
					{title}
				</a>
			</h3>

			<p class="text-white/70 text-sm leading-relaxed">
				{shortDescription}
			</p>

			<!-- Tags -->
			<div class="flex flex-wrap gap-2">
				{tags.slice(0, 3).map((tag) => (
					<span class="px-2 py-1 text-xs bg-white/10 text-white/80 rounded-md font-mono">
						{tag}
					</span>
				))}
				{tags.length > 3 && (
					<span class="px-2 py-1 text-xs bg-white/10 text-white/60 rounded-md">
						+{tags.length - 3}
					</span>
				)}
			</div>
		</div>

		<!-- Action -->
		<div class="pt-4 border-t border-white/10">
			<a
				href={href}
				class="inline-flex items-center space-x-2 text-purple-400 hover:text-purple-300 text-sm font-medium transition-colors group"
			>
				<span>Usar herramienta</span>
				<svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
				</svg>
			</a>
		</div>
	</div>
</article>
