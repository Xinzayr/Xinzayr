---
// Componente para mostrar estadísticas reales de GitHub
import { API_CONFIG } from '../consts';

interface Props {
  variant?: 'compact' | 'detailed';
}

const { variant = 'compact' } = Astro.props;

// Obtener configuración de GitHub desde constants
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || API_CONFIG.github.token;
const GITHUB_USERNAME = API_CONFIG.github.username;

let githubStats = null;

// Obtener estadísticas reales de GitHub si hay token configurado
if (GITHUB_TOKEN && GITHUB_USERNAME) {
  try {
    // Obtener información del usuario
    const userResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}`, {
      headers: {
        'Authorization': `token ${GITHUB_TOKEN}`,
        'Accept': 'application/vnd.github.v3+json'
      }
    });

    // Obtener repositorios del usuario
    const reposResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?type=all&per_page=100`, {
      headers: {
        'Authorization': `token ${GITHUB_TOKEN}`,
        'Accept': 'application/vnd.github.v3+json'
      }
    });

    if (userResponse.ok && reposResponse.ok) {
      const userData = await userResponse.json();
      const reposData = await reposResponse.json();

      // Calcular estadísticas
      const totalStars = reposData.reduce((sum: number, repo: any) => sum + repo.stargazers_count, 0);
      const totalForks = reposData.reduce((sum: number, repo: any) => sum + repo.forks_count, 0);
      const languages = reposData
        .filter((repo: any) => repo.language)
        .reduce((acc: any, repo: any) => {
          acc[repo.language] = (acc[repo.language] || 0) + 1;
          return acc;
        }, {});

      const topLanguages = Object.entries(languages)
        .sort(([,a]: any, [,b]: any) => b - a)
        .slice(0, 5);

      githubStats = {
        followers: userData.followers,
        following: userData.following,
        publicRepos: userData.public_repos,
        totalStars,
        totalForks,
        topLanguages,
        joinedDate: new Date(userData.created_at),
        lastUpdated: new Date(userData.updated_at)
      };
    }
  } catch (error) {
    console.warn('Error fetching GitHub stats:', error);
  }
}

// Función para formatear números grandes
function formatNumber(num: number): string {
  if (num >= 1000000) {
    return (num / 1000000).toFixed(1) + 'M';
  } else if (num >= 1000) {
    return (num / 1000).toFixed(1) + 'K';
  }
  return num.toString();
}

// Función para formatear fecha
function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long'
  });
}
---

{githubStats ? (
  <>
    {variant === 'compact' ? (
      <!-- Vista compacta para estadísticas rápidas -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="glass rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-blue-400">{formatNumber(githubStats.publicRepos)}</div>
          <div class="text-white/60 text-xs">Repositorios</div>
        </div>
        <div class="glass rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-yellow-400">{formatNumber(githubStats.totalStars)}</div>
          <div class="text-white/60 text-xs">Stars</div>
        </div>
        <div class="glass rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-green-400">{formatNumber(githubStats.followers)}</div>
          <div class="text-white/60 text-xs">Seguidores</div>
        </div>
        <div class="glass rounded-lg p-4 text-center">
          <div class="text-2xl font-bold text-purple-400">{formatNumber(githubStats.totalForks)}</div>
          <div class="text-white/60 text-xs">Forks</div>
        </div>
      </div>
    ) : (
      <!-- Vista detallada -->
      <div class="space-y-6">
        <!-- Estadísticas principales -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="glass rounded-lg p-6 text-center">
            <div class="text-3xl font-bold text-blue-400 mb-2">{formatNumber(githubStats.publicRepos)}</div>
            <div class="text-white/80 text-sm font-medium">Repositorios Públicos</div>
            <div class="text-white/50 text-xs mt-1">Proyectos de código abierto</div>
          </div>
          <div class="glass rounded-lg p-6 text-center">
            <div class="text-3xl font-bold text-yellow-400 mb-2">{formatNumber(githubStats.totalStars)}</div>
            <div class="text-white/80 text-sm font-medium">Total de Stars</div>
            <div class="text-white/50 text-xs mt-1">Reconocimiento de la comunidad</div>
          </div>
          <div class="glass rounded-lg p-6 text-center">
            <div class="text-3xl font-bold text-green-400 mb-2">{formatNumber(githubStats.followers)}</div>
            <div class="text-white/80 text-sm font-medium">Seguidores</div>
            <div class="text-white/50 text-xs mt-1">Red profesional</div>
          </div>
          <div class="glass rounded-lg p-6 text-center">
            <div class="text-3xl font-bold text-purple-400 mb-2">{formatNumber(githubStats.totalForks)}</div>
            <div class="text-white/80 text-sm font-medium">Total de Forks</div>
            <div class="text-white/50 text-xs mt-1">Contribuciones de otros</div>
          </div>
        </div>

        <!-- Lenguajes más utilizados -->
        <div class="glass rounded-lg p-6">
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center">
            <svg class="w-5 h-5 text-blue-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            Lenguajes Más Utilizados
          </h3>
          <div class="space-y-3">
            {githubStats.topLanguages.map((langData: any, index: number) => {
              const [language, count] = langData;
              return (
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-3">
                    <div class={`w-3 h-3 rounded-full ${
                      index === 0 ? 'bg-blue-400' :
                      index === 1 ? 'bg-green-400' :
                      index === 2 ? 'bg-yellow-400' :
                      index === 3 ? 'bg-purple-400' : 'bg-gray-400'
                    }`}></div>
                    <span class="text-white/80 text-sm">{language}</span>
                  </div>
                  <span class="text-white/60 text-sm">{count} repos</span>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Información adicional -->
        <div class="glass rounded-lg p-6">
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center">
            <svg class="w-5 h-5 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Actividad en GitHub
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div class="flex justify-between">
              <span class="text-white/60">Miembro desde:</span>
              <span class="text-white/80">{formatDate(githubStats.joinedDate)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/60">Siguiendo:</span>
              <span class="text-white/80">{githubStats.following} personas</span>
            </div>
          </div>
        </div>
      </div>
    )}
  </>
) : (
  <!-- Mostrar cuando no hay datos configurados -->
  <div class="glass rounded-lg p-6 text-center">
    <svg class="w-12 h-12 text-white/40 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2-2V7a2 2 0 012-2h2a2 2 0 002 2v2a2 2 0 002 2h2a2 2 0 012-2V7a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 00-2 2h-2a2 2 0 00-2 2v6a2 2 0 01-2 2H9a2 2 0 01-2-2z"/>
    </svg>
    <h3 class="text-white font-medium mb-2">Estadísticas de GitHub no disponibles</h3>
    <p class="text-white/60 text-sm">
      Las estadísticas se mostrarán cuando el token de GitHub esté configurado.
    </p>
  </div>
)}

<style>
  .glass {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>
