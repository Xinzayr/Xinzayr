---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="¡Mensaje enviado! - xinzayr" description="Tu mensaje ha sido enviado correctamente. Te responderé en las próximas 24-48 horas.">
	<Header />

	<main class="min-h-screen pt-16 flex items-center justify-center">
		<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<!-- Success Icon -->
			<div class="mb-8">
				<div class="w-20 h-20 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
					<svg class="w-10 h-10 text-green-400" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
					</svg>
				</div>

				<h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">
					¡Mensaje enviado!
				</h1>

				<p class="text-xl text-white/80 mb-8">
					Gracias por contactarme. He recibido tu mensaje y te responderé en las próximas <strong>24-48 horas</strong>.
				</p>
			</div>

			<!-- Next Steps -->
			<div class="glass rounded-xl p-8 mb-8">
				<h2 class="text-2xl font-bold text-white mb-6">¿Qué sigue?</h2>

				<div class="space-y-4 text-left">
					<div class="flex items-start space-x-4">
						<div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
							<span class="text-blue-400 font-bold text-sm">1</span>
						</div>
						<div>
							<h3 class="text-white font-medium mb-1">Revisión del mensaje</h3>
							<p class="text-white/70 text-sm">Revisaré tu mensaje en detalle para entender tus necesidades.</p>
						</div>
					</div>

					<div class="flex items-start space-x-4">
						<div class="w-8 h-8 bg-purple-500/20 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
							<span class="text-purple-400 font-bold text-sm">2</span>
						</div>
						<div>
							<h3 class="text-white font-medium mb-1">Análisis de factibilidad</h3>
							<p class="text-white/70 text-sm">Evaluaré la viabilidad técnica y los recursos necesarios.</p>
						</div>
					</div>

					<div class="flex items-start space-x-4">
						<div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
							<span class="text-green-400 font-bold text-sm">3</span>
						</div>
						<div>
							<h3 class="text-white font-medium mb-1">Respuesta personalizada</h3>
							<p class="text-white/70 text-sm">Te enviaré una respuesta detallada con propuestas y próximos pasos.</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Actions -->
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a
					href="/"
					class="inline-flex items-center justify-center px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-black"
				>
					<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
					</svg>
					Ir al inicio
				</a>

				<a
					href="/projects"
					class="inline-flex items-center justify-center px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-medium rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-black"
				>
					<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
					</svg>
					Ver mis proyectos
				</a>
			</div>

			<!-- Contact Info Reminder -->
			<div class="mt-12 p-6 bg-white/5 rounded-lg">
				<p class="text-white/60 text-sm">
					<strong>Tiempo de respuesta:</strong> 24-48 horas ·
					<strong>Zona horaria:</strong> UTC-5 (América/Lima) ·
					<strong>Email:</strong> Verificaré mi bandeja regularmente
				</p>
			</div>
		</div>
	</main>

	<Footer />
</BaseLayout>
