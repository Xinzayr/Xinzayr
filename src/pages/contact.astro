---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDeploymentInfo, EXTERNAL_RESOURCES } from '../utils/env-detection';

const deploymentInfo = getDeploymentInfo();
---

<BaseLayout title="Contacto - xinzayr" description="Ponte en contacto conmigo para colaboraciones, proyectos o consultas profesionales.">
	<Header />

	<main class="min-h-screen pt-16">
		<!-- Hero Section -->
		<section class="py-20">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h1 class="text-4xl lg:text-5xl font-bold text-white mb-6">
						¡Hablemos!
					</h1>
					<p class="text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">
						¿Tienes un proyecto en mente? ¿Necesitas consultoría técnica?
						¡Me encantaría escuchar de ti y explorar cómo podemos trabajar juntos!
					</p>
				</div>
			</div>
		</section>

		<!-- Contact Content -->
		<section class="pb-20">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
					<!-- Contact Form -->
					<div class="glass rounded-xl p-8">
						<h2 class="text-2xl font-bold text-white mb-6">Envíame un mensaje</h2>

						<form action="https://formspree.io/f/xeozlgkj" method="POST" class="space-y-6" id="contact-form">
							<div>
								<label for="name" class="block text-sm font-medium text-white/80 mb-2">
									Nombre completo *
								</label>
								<input
									type="text"
									id="name"
									name="name"
									required
									class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
									placeholder="Tu nombre completo"
								/>
							</div>

							<div>
								<label for="email" class="block text-sm font-medium text-white/80 mb-2">
									Correo electrónico *
								</label>
								<input
									type="email"
									id="email"
									name="_replyto"
									required
									class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
									placeholder="tu@email.com"
								/>
							</div>

							<div>
								<label for="subject" class="block text-sm font-medium text-white/80 mb-2">
									Asunto *
								</label>
								<select
									id="subject"
									name="_subject"
									required
									class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
								>
									<option value="" disabled selected class="bg-gray-800">Selecciona un tema</option>
									<option value="💼 Nuevo proyecto - xinzayr.xyz" class="bg-gray-800">💼 Nuevo proyecto</option>
									<option value="🤝 Colaboración - xinzayr.xyz" class="bg-gray-800">🤝 Colaboración</option>
									<option value="💡 Consultoría técnica - xinzayr.xyz" class="bg-gray-800">💡 Consultoría técnica</option>
									<option value="💻 Oportunidad laboral - xinzayr.xyz" class="bg-gray-800">💻 Oportunidad laboral</option>
									<option value="❓ Consulta general - xinzayr.xyz" class="bg-gray-800">❓ Consulta general</option>
									<option value="🐛 Reporte de bug - xinzayr.xyz" class="bg-gray-800">🐛 Reporte de bug</option>
									<option value="✨ Sugerencia - xinzayr.xyz" class="bg-gray-800">✨ Sugerencia</option>
								</select>
							</div>

							<div>
								<label for="company" class="block text-sm font-medium text-white/80 mb-2">
									Empresa/Organización <span class="text-white/50">(opcional)</span>
								</label>
								<input
									type="text"
									id="company"
									name="company"
									class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
									placeholder="Nombre de tu empresa u organización"
								/>
							</div>

							<div>
								<label for="message" class="block text-sm font-medium text-white/80 mb-2">
									Mensaje *
								</label>
								<textarea
									id="message"
									name="message"
									rows="6"
									required
									class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none transition-all"
									placeholder="Cuéntame sobre tu proyecto, consulta o propuesta. Incluye todos los detalles relevantes para poder ayudarte mejor..."
								></textarea>
								<div class="text-xs text-white/50 mt-1">
									Mínimo 10 caracteres
								</div>
							</div>

							<!-- Campos ocultos de Formspree -->
							<input type="hidden" name="_captcha" value="false">
							<input type="hidden" name="_next" value="https://xinzayr.xyz/contact-success">
							<input type="hidden" name="_subject" value="Nuevo mensaje desde xinzayr.xyz">
							<input type="hidden" name="_format" value="plain">

							<div class="flex flex-col sm:flex-row gap-4">
								<button
									type="submit"
									id="submit-btn"
									class="flex-1 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-black disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center space-x-2"
								>
									<span id="submit-text">Enviar mensaje</span>
									<svg id="submit-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
									</svg>
								</button>
								<button
									type="reset"
									class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-black"
								>
									Limpiar
								</button>
							</div>

							<!-- Mensaje de estado -->
							<div id="form-status" class="hidden p-4 rounded-lg"></div>
						</form>
					</div>

					<!-- Contact Info & Social -->
					<div class="space-y-8">
						<!-- Contact Methods -->
						<div class="glass rounded-xl p-8">
							<h2 class="text-2xl font-bold text-white mb-6">Información de contacto</h2>

							<div class="space-y-4">
								<div class="flex items-center space-x-4">
									<div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center">
										<svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
										</svg>
									</div>
									<div>
										<h3 class="text-white font-medium">Email</h3>
										<p class="text-white/70">Respuesta en 24-48 horas</p>
									</div>
								</div>

								<div class="flex items-center space-x-4">
									<div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center">
										<svg class="w-6 h-6 text-green-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
										</svg>
									</div>
									<div>
										<h3 class="text-white font-medium">Discord</h3>
										<p class="text-white/70">Respuesta rápida</p>
									</div>
								</div>

								<div class="flex items-center space-x-4">
									<div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center">
										<svg class="w-6 h-6 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
										</svg>
									</div>
									<div>
										<h3 class="text-white font-medium">GitHub</h3>
										<p class="text-white/70">Ve mi código</p>
									</div>
								</div>
							</div>
						</div>

						<!-- Status & Availability -->
						<div class="glass rounded-xl p-8">
							<h2 class="text-2xl font-bold text-white mb-6">Estado actual</h2>

							<div class="space-y-4">
								<div class="flex items-center justify-between p-4 bg-green-500/10 border border-green-500/20 rounded-lg">
									<div class="flex items-center space-x-3">
										<div class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
										<span class="text-white font-medium">Disponible para proyectos</span>
									</div>
								</div>

								<div class="flex items-center justify-between p-4 bg-blue-500/10 border border-blue-500/20 rounded-lg">
									<div class="flex items-center space-x-3">
										<div class="w-3 h-3 bg-blue-400 rounded-full"></div>
										<span class="text-white font-medium">Respondiendo emails</span>
									</div>
								</div>

								<div class="text-sm text-white/60 mt-4">
									<p>Tiempo de respuesta promedio: 24-48 horas</p>
									<p>Zona horaria: UTC-5 (América/Lima)</p>
								</div>
							</div>
						</div>

						<!-- Social Links & Support -->
						<div class="glass rounded-xl p-8">
							<h2 class="text-2xl font-bold text-white mb-6">Sígueme y apóyame</h2>

							<!-- Social Links -->
							<div class="grid grid-cols-2 gap-4 mb-6">
								<a
									href={EXTERNAL_RESOURCES.GITHUB_PROFILE}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center space-x-3 p-3 bg-white/10 hover:bg-white/20 rounded-lg transition-colors"
								>
									<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
										<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
									</svg>
									<span class="text-white text-sm">GitHub</span>
								</a>

								<a
									href={EXTERNAL_RESOURCES.X_TWITTER}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center space-x-3 p-3 bg-white/10 hover:bg-white/20 rounded-lg transition-colors"
								>
									<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
										<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
									</svg>
									<span class="text-white text-sm">X (Twitter)</span>
								</a>

								<a
									href={EXTERNAL_RESOURCES.DISCORD_INVITE}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center space-x-3 p-3 bg-white/10 hover:bg-white/20 rounded-lg transition-colors"
								>
									<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
										<path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
									</svg>
									<span class="text-white text-sm">Discord</span>
								</a>

								<a
									href={EXTERNAL_RESOURCES.LINKEDIN}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center space-x-3 p-3 bg-white/10 hover:bg-white/20 rounded-lg transition-colors"
								>
									<svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
									</svg>
									<span class="text-white text-sm">LinkedIn</span>
								</a>
							</div>

							<!-- Support/Donation -->
							<div class="border-t border-white/10 pt-6">
								<p class="text-white/70 text-sm mb-4">
									Si mi trabajo te ha sido útil, considera apoyarme:
								</p>
								<div class="space-y-3">
									<!-- PayPal -->
									<a
										href={EXTERNAL_RESOURCES.PAYPAL}
										target="_blank"
										rel="noopener noreferrer"
										class="flex items-center space-x-3 p-3 bg-blue-500/10 hover:bg-blue-500/20 border border-blue-500/20 rounded-lg transition-colors"
									>
										<svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106zm14.146-14.42a3.35 3.35 0 0 0-.607-.541c-.013.076-.026.175-.041.258-.93 4.778-4.005 6.405-7.967 6.405h-2.256c-.524 0-.968.382-1.05.9L7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81.302.344.544.719.73 1.107z"/>
										</svg>
										<span class="text-white text-sm">Donar via PayPal</span>
									</a>

									<!-- Ko-fi -->
									<a
										href={EXTERNAL_RESOURCES.KOFI}
										target="_blank"
										rel="noopener noreferrer"
										class="flex items-center space-x-3 p-3 bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/20 rounded-lg transition-colors"
									>
										<svg class="w-5 h-5 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.061 11.493c.02 4.169 2.925 2.925 2.925 2.925s1.188.087 1.591.087c.403 0 .96-.087.96-.087s1.871-6.447 1.871-6.447h5.091s.456 6.447.456 6.447 2.064.087 2.467.087c.403 0 .96-.087.96-.087s-.456-13.455-.456-13.455c0 0 6.267-.317 6.267-7.317z"/>
										</svg>
										<span class="text-white text-sm">Invítame un café</span>
									</a>

									<!-- Patreon -->
									<a
										href={EXTERNAL_RESOURCES.PATREON}
										target="_blank"
										rel="noopener noreferrer"
										class="flex items-center space-x-3 p-3 bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/20 rounded-lg transition-colors"
									>
										<svg class="w-5 h-5 text-orange-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M0 .48v23.04h4.22V.48zm15.385 0c-4.764 0-8.641 3.88-8.641 8.65 0 4.755 3.877 8.623 8.641 8.623 4.75 0 8.615-3.868 8.615-8.623C24 4.36 20.136.48 15.385.48z"/>
										</svg>
										<span class="text-white text-sm">Apóyame en Patreon</span>
									</a>

									<!-- Buy Me a Coffee -->
									<a
										href={EXTERNAL_RESOURCES.BUYMEACOFFEE}
										target="_blank"
										rel="noopener noreferrer"
										class="flex items-center space-x-3 p-3 bg-yellow-500/10 hover:bg-yellow-500/20 border border-yellow-500/20 rounded-lg transition-colors"
									>
										<svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-.766-1.688a4.178 4.178 0 0 0-1.513-1.293c-.554-.32-1.177-.492-1.819-.492a9.958 9.958 0 0 0-.438.012 9.013 9.013 0 0 0-.96.131 7.892 7.892 0 0 0-1.204.315 6.491 6.491 0 0 0-1.166.57c-.344.258-.648.569-.904.926-.256.357-.454.756-.59 1.18a4.5 4.5 0 0 0-.211 1.329c0 .598.065 1.174.196 1.725.131.551.329 1.075.593 1.566.264.49.593.94.984 1.349.391.408.854.765 1.387 1.07.534.305 1.133.545 1.798.72.665.175 1.39.263 2.174.263.784 0 1.509-.088 2.174-.263.665-.175 1.264-.415 1.798-.72.533-.305.996-.662 1.387-1.07.391-.409.72-.859.984-1.349.264-.491.462-1.015.593-1.566.131-.551.196-1.127.196-1.725 0-.446-.07-.886-.211-1.329a4.178 4.178 0 0 0-.59-1.18 4.5 4.5 0 0 0-.904-.926 6.491 6.491 0 0 0-1.166-.57 7.892 7.892 0 0 0-1.204-.315 9.013 9.013 0 0 0-.96-.131 9.958 9.958 0 0 0-.438-.012z"/>
										</svg>
