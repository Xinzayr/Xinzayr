									<!-- GitHub Sponsors -->
									<a
										href={EXTERNAL_RESOURCES.GITHUB_SPONSORS}
										target="_blank"
										rel="noopener noreferrer"
										class="flex items-center space-x-3 p-3 bg-pink-500/10 hover:bg-pink-500/20 border border-pink-500/20 rounded-lg transition-colors"
									>
										<svg class="w-5 h-5 text-pink-400" fill="currentColor" viewBox="0 0 24 24">
											<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
										</svg>
										<span class="text-white text-sm">GitHub Sponsors</span>
									</a>
								</div>
							</div>
