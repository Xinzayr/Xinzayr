---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PasswordGeneratorComponent from '../../components/tools/PasswordGenerator';
---

<BaseLayout 
  title="Generador de Contraseñas Seguras - xinzayr" 
  description="Genera contraseñas fuertes y seguras directamente en tu navegador sin enviar datos a ningún servidor."
>
  <Header />

  <main class="min-h-screen pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb & Top Bar */}
      <div class="flex items-center justify-between mb-8">
        <a
          href="/tools"
          class="glass-pill inline-flex items-center space-x-2 px-4 py-2 text-sm text-white/80 hover:text-cyber-cyan hover:border-cyber-cyan/40 transition-all"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <span>Volver a Herramientas</span>
        </a>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 bg-cyber-cyan rounded-full animate-pulse"></span>
          <span class="text-xs font-mono text-cyber-cyan tracking-wider uppercase">Seguridad Criptográfica</span>
        </div>
      </div>

      {/* Header */}
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-cyber-cyan/10 border border-cyber-cyan/30 mb-6 shadow-lg shadow-cyber-cyan/10">
          <svg class="w-8 h-8 text-cyber-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
        </div>
        <h1 class="text-4xl md:text-5xl font-display font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400 mb-6">Generador de Contraseñas</h1>
        <p class="text-lg md:text-xl text-white/70 max-w-2xl mx-auto font-body leading-relaxed">
          Crea contraseñas robustas y seguras localmente en tu navegador. Tus contraseñas nunca se envían a ningún servidor, garantizando un 100% de privacidad.
        </p>
      </div>

      {/* Herramienta React */}
      <div class="mt-8 relative z-10">
        <PasswordGeneratorComponent client:load />
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
