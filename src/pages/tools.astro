---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const tools = [
  {
    id: 'cybermath',
    title: 'CyberMath Studio',
    description: 'Calculadora científica interactiva, plano cartesiano 2D GeoGebra e inspección de pasos procedurales estilo PhotoMath.',
    icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
    category: 'math',
    categoryLabel: 'Matemáticas & Ciencia',
    badge: 'Destacado',
    href: '/tools/calculator',
    color: 'cyber-cyan'
  },
  {
    id: 'password-gen',
    title: 'Generador Criptográfico',
    description: 'Crea contraseñas robustas y seguras localmente en tu navegador con cifrado de entropía y 100% de privacidad.',
    icon: 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z',
    category: 'utils',
    categoryLabel: 'Seguridad Criptográfica',
    badge: 'Seguridad',
    href: '/tools/password-generator',
    color: 'cyber-green'
  }
];
---

<BaseLayout
  title="Extras & Herramientas - xinzayr"
  description="Colección de herramientas web interactivas, calculadora científica gráfica CyberMath y generador criptográfico de contraseñas."
>
  <Header />

  <main class="min-h-screen pt-24 pb-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header Section -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-cyber-cyan/10 border border-cyber-cyan/30 text-cyber-cyan text-xs font-mono mb-4">
          <span class="w-2 h-2 rounded-full bg-cyber-cyan animate-pulse"></span>
          <span>SUITE DE EXTRAS & HERRAMIENTAS</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-display font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400 mb-6">
          Extras & Herramientas
        </h1>
        <p class="text-lg md:text-xl text-white/70 max-w-3xl mx-auto font-body leading-relaxed">
          Explora nuestras herramientas avanzadas de cálculo gráfico, análisis matemático procedural y seguridad criptográfica local.
        </p>
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto" id="tools-grid">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="tool-card group block glass-card rounded-2xl p-8 border border-white/10 transition-all duration-300 hover:-translate-y-1 hover:border-cyber-cyan/60 shadow-xl shadow-cyber-cyan/5 relative overflow-hidden flex flex-col justify-between"
          >
            <!-- Background Glow Effect on Hover -->
            <div class="absolute -right-10 -top-10 w-40 h-40 bg-cyber-cyan/10 rounded-full blur-3xl group-hover:bg-cyber-cyan/20 transition-all duration-500 pointer-events-none"></div>

            <div>
              <div class="flex items-start justify-between mb-6 relative z-10">
                <div class={`w-14 h-14 rounded-2xl flex items-center justify-center border transition-all ${
                  tool.color === 'cyber-cyan' 
                    ? 'bg-cyber-cyan/10 border-cyber-cyan/30 text-cyber-cyan group-hover:bg-cyber-cyan/20' 
                    : 'bg-cyber-green/10 border-cyber-green/30 text-cyber-green group-hover:bg-cyber-green/20'
                }`}>
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tool.icon}></path>
                  </svg>
                </div>

                <div class="flex items-center space-x-2">
                  <span class="text-[10px] font-mono uppercase tracking-wider px-3 py-1 rounded-full bg-white/10 text-white/70 border border-white/5">
                    {tool.categoryLabel}
                  </span>
                  <span class="text-[10px] font-mono uppercase tracking-wider px-3 py-1 rounded-full border bg-cyber-cyan/20 text-cyber-cyan border-cyber-cyan/40">
                    {tool.badge}
                  </span>
                </div>
              </div>

              <h3 class="text-3xl font-display font-bold text-white mb-3 group-hover:text-cyber-cyan transition-colors relative z-10">
                {tool.title}
              </h3>

              <p class="text-white/70 font-body text-base leading-relaxed mb-8 relative z-10">
                {tool.description}
              </p>
            </div>

            <div class="flex items-center text-sm font-semibold text-cyber-cyan group-hover:translate-x-1 transition-transform relative z-10 pt-4 border-t border-white/5">
              <span>Abrir Herramienta</span>
              <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Suggestion Banner -->
      <div class="mt-16 glass-card rounded-2xl p-8 border border-white/10 text-center relative overflow-hidden max-w-3xl mx-auto">
        <h3 class="text-2xl font-display font-bold text-white mb-2">¿Tienes alguna sugerencia de módulo adicional?</h3>
        <p class="text-white/70 font-body text-sm mb-6 max-w-xl mx-auto">
          ¿Te gustaría ver alguna otra funcionalidad matemática o utilitaria integrada en el sitio? Cuéntanos tu idea.
        </p>
        <a
          href="/contact"
          class="btn-primary inline-flex items-center space-x-2 px-8 py-3.5 font-semibold text-white shadow-lg shadow-cyber-cyan/20"
        >
          <span>Sugerir Herramienta</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
