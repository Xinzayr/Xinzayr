---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GitHubRepos from '../components/GitHubRepos.astro';
import { getCollection } from 'astro:content';

// Obtener todos los proyectos del contenido local
const allProjects = await getCollection('projects');

// Ordenar por fecha de publicación (más recientes primero)
const projects = allProjects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Obtener todas las tecnologías únicas para filtros
const allTechnologies = [...new Set(projects.flatMap(project => project.data.stack))].sort();
const allCategories = [...new Set(projects.map(project => project.data.category))].sort();
---

<BaseLayout title="Proyectos - xinzayr" description="Explora mi portfolio de proyectos de desarrollo web, aplicaciones móviles y herramientas innovadoras.">
	<Header />

	<main class="min-h-screen pt-16">
		<!-- Hero Section -->
		<section class="py-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h1 class="text-4xl lg:text-5xl font-bold text-white mb-6">
						Mis Proyectos
					</h1>
					<p class="text-xl text-white/80 max-w-3xl mx-auto leading-relaxed">
						Una colección de proyectos que demuestran mi experiencia en desarrollo full-stack,
						desde aplicaciones web modernas hasta herramientas innovadoras.
					</p>
				</div>

				<!-- Stats -->
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto mb-16">
					<div class="glass rounded-lg p-6 text-center">
						<div class="text-3xl font-bold text-blue-400 mb-2">15+</div>
						<div class="text-white/70 text-sm">Repositorios públicos</div>
					</div>
					<div class="glass rounded-lg p-6 text-center">
						<div class="text-3xl font-bold text-purple-400 mb-2">{allTechnologies.length}+</div>
						<div class="text-white/70 text-sm">Tecnologías</div>
					</div>
					<div class="glass rounded-lg p-6 text-center">
						<div class="text-3xl font-bold text-green-400 mb-2">{projects.filter(p => p.data.featured).length}</div>
						<div class="text-white/70 text-sm">Destacados locales</div>
					</div>
				</div>
			</div>
		</section>

		<!-- GitHub Repositories Section -->
		<section class="py-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
						Repositorios de GitHub
					</h2>
					<p class="text-white/70 text-lg max-w-2xl mx-auto">
						Mis proyectos más recientes y activos en GitHub
					</p>
				</div>

				<GitHubRepos variant="grid" limit={12} />

				<div class="text-center mt-12">
					<a
						href="https://github.com/xinzayr"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center space-x-2 text-blue-400 hover:text-blue-300 font-medium transition-colors"
					>
						<span>Ver más en GitHub</span>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
						</svg>
					</a>
				</div>
			</div>
		</section>

		<!-- Categorized Projects Section -->
		{projects.length > 0 && (
			<section class="py-20 bg-white/5 backdrop-blur-sm">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="text-center mb-12">
						<h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
							Proyectos Destacados
						</h2>
						<p class="text-white/70 text-lg max-w-2xl mx-auto">
							Información detallada de proyectos seleccionados
						</p>
					</div>

					<!-- Categories -->
					<div class="space-y-16">
						{allCategories.map((category) => {
							const categoryProjects = projects.filter(p => p.data.category === category);
							return categoryProjects.length > 0 && (
								<div>
									<h3 class="text-2xl font-bold text-white mb-8 text-center">
										{category}
									</h3>
									<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
										{categoryProjects.map((project) => (
											<a
												href={`/projects/${project.id}`}
												class="block glass rounded-xl p-6 glass-hover group"
											>
												<div class="flex items-start justify-between mb-4">
													<h4 class="text-white font-semibold text-lg group-hover:text-blue-400 transition-colors">
														{project.data.title}
													</h4>
													<div class="ml-4">
														<svg class="w-5 h-5 text-white/40 group-hover:text-white/60 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
															<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
														</svg>
													</div>
												</div>
												<p class="text-white/60 text-sm mb-4 line-clamp-3">
													{project.data.shortDescription}
												</p>
												<div class="flex flex-wrap gap-2">
													{project.data.stack.slice(0, 4).map((tech) => (
														<span class="px-2 py-1 bg-white/10 text-white/70 text-xs rounded-md">
															{tech}
														</span>
													))}
													{project.data.stack.length > 4 && (
														<span class="px-2 py-1 bg-white/10 text-white/70 text-xs rounded-md">
															+{project.data.stack.length - 4}
														</span>
													)}
												</div>
											</a>
										))}
									</div>
								</div>
							);
						})}
					</div>
				</div>
			</section>
		)}
	</main>

	<Footer />

	<style>
		.line-clamp-3 {
			display: -webkit-box;
			-webkit-line-clamp: 3;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	</style>
</BaseLayout>
