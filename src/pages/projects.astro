---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GitHubRepos from '../components/GitHubRepos.astro';
import DynamicProjectCards from '../components/DynamicProjectCards.astro';
import GitHubRepoCards from '../components/GitHubRepoCards.astro';
import GitHubContributionGraph from '../components/GitHubContributionGraph.astro';
import TechDistribution from '../components/TechDistribution.astro';
import { getCollection } from 'astro:content';
import { API_CONFIG } from '../consts';

// Obtener todos los proyectos del contenido local
const allProjects = await getCollection('projects');

// Ordenar por fecha de publicación (más recientes primero)
const projects = allProjects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Obtener todas las tecnologías únicas para filtros
const allTechnologies = [...new Set(projects.flatMap((project) => project.data.stack))].sort();
const allCategories = [...new Set(projects.map((project) => project.data.category))].sort();

// Obtener estadísticas reales de GitHub
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || API_CONFIG.github.token;
const GITHUB_USERNAME = import.meta.env.GITHUB_USERNAME || API_CONFIG.github.username || 'xinzayr';

let githubStats = {
  publicRepos: 0,
  totalLanguages: 0,
  totalStars: 0,
  totalForks: 0,
  lastUpdated: '',
  topLanguage: '',
  activeRepos: [],
  languageDistribution: {},
  loaded: false
};

if (GITHUB_USERNAME) {
  try {
    const headers: any = {
      Accept: 'application/vnd.github.v3+json',
      'User-Agent': 'xinzayr-portfolio',
    };
    if (GITHUB_TOKEN) {
      headers['Authorization'] = `Bearer ${GITHUB_TOKEN}`;
    }

    // Obtener información del usuario
    const userResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}`, { headers });

    // Obtener repositorios del usuario
    const reposResponse = await fetch(
      `https://api.github.com/users/${GITHUB_USERNAME}/repos?type=public&per_page=100&sort=updated`,
      { headers }
    );

    if (userResponse.ok && reposResponse.ok) {
      const userData = await userResponse.json();
      const reposData = await reposResponse.json();

      // Filtrar repositorios públicos y no archivados
      const activePublicRepos = reposData.filter((repo: any) => !repo.private && !repo.archived);

      // Calcular estadísticas básicas
      githubStats.publicRepos = activePublicRepos.length || userData.public_repos || 0;
      githubStats.totalStars = activePublicRepos.reduce(
        (sum: number, repo: any) => sum + repo.stargazers_count,
        0,
      );
      githubStats.totalForks = activePublicRepos.reduce(
        (sum: number, repo: any) => sum + repo.forks_count,
        0,
      );

      // Obtener información real de lenguajes y distribución por bytes
      const languageBytesMap: Record<string, number> = {};
      const langFetches = activePublicRepos.slice(0, 20).map(async (repo: any) => {
        try {
          const lRes = await fetch(`https://api.github.com/repos/${GITHUB_USERNAME}/${repo.name}/languages`, { headers });
          if (lRes.ok) {
            const langsData = await lRes.json();
            return { langs: langsData, fallbackLang: repo.language };
          }
        } catch (e) {}
        return { langs: null, fallbackLang: repo.language };
      });

      const langResults = await Promise.allSettled(langFetches);

      langResults.forEach((result) => {
        if (result.status === 'fulfilled' && result.value) {
          const { langs, fallbackLang } = result.value;
          if (langs && Object.keys(langs).length > 0) {
            Object.entries(langs).forEach(([lang, bytes]) => {
              const b = Number(bytes) || 0;
              languageBytesMap[lang] = (languageBytesMap[lang] || 0) + b;
            });
          } else if (fallbackLang) {
            languageBytesMap[fallbackLang] = (languageBytesMap[fallbackLang] || 0) + 50000;
          }
        }
      });

      const sortedLanguages = Object.entries(languageBytesMap).sort(
        ([, a], [, b]) => (b as number) - (a as number),
      );

      githubStats.totalLanguages = Object.keys(languageBytesMap).length;
      githubStats.languageDistribution = languageBytesMap;
      githubStats.topLanguage = sortedLanguages.length > 0 ? sortedLanguages[0][0] : '';
      githubStats.loaded = true;

      // Obtener la fecha del último repositorio actualizado
      if (activePublicRepos.length > 0) {
        githubStats.lastUpdated = activePublicRepos[0].updated_at;
      }

      // Guardar información de los repos activos para mostrar detalles
      githubStats.activeRepos = activePublicRepos.map((repo: any) => ({
        name: repo.name,
        language: repo.language,
        stars: repo.stargazers_count,
        updated: repo.updated_at,
      }));
    }
  } catch (error) {
    console.warn('Error fetching GitHub stats for projects page:', error);
  }
}
---

<BaseLayout
  title="Proyectos - xinzayr"
  description="Explora mi portfolio de proyectos de desarrollo web, aplicaciones móviles y herramientas innovadoras."
>
  <Header />

  <main class="min-h-screen pt-16">
    <!-- Hero Section -->
    <section class="py-12 sm:py-20">
      <div class="max-w-7xl 2xl:max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 sm:mb-6">Mis Proyectos</h1>
          <p class="text-lg sm:text-xl text-white/80 max-w-3xl mx-auto leading-relaxed">
            Una colección de proyectos que demuestran mi experiencia en desarrollo, desde
            aplicaciones modernas, herramientas e ideas innovadoras.
          </p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 max-w-5xl mx-auto mb-12 sm:mb-16">
          <div class="glass rounded-lg p-6 text-center">
            <div class="text-3xl font-bold text-blue-400 mb-2">
              {githubStats.loaded ? githubStats.publicRepos : '...'}
            </div>
            <div class="text-white/70 text-sm">Repositorios públicos</div>
          </div>
          <div class="glass rounded-lg p-6 text-center border border-purple-500/20 hover:border-purple-500/40 transition-all">
            <div id="stat-total-languages" class="text-3xl font-bold text-purple-400 mb-2 font-mono">
              {githubStats.loaded ? githubStats.totalLanguages : '...'}
            </div>
            <div class="text-white/70 text-sm">Lenguajes de programación</div>
            <div id="stat-top-language" class="text-xs text-purple-300 mt-1 font-mono">
              {githubStats.topLanguage ? `Principal: ${githubStats.topLanguage}` : 'Analizando...'}
            </div>
          </div>
          <div class="glass rounded-lg p-6 text-center">
            <div class="text-3xl font-bold text-yellow-400 mb-2">
              {githubStats.loaded ? githubStats.totalStars : '0'}
            </div>
            <div class="text-white/70 text-sm">Estrellas totales</div>
          </div>
          <div class="glass rounded-lg p-6 text-center">
            <div class="text-3xl font-bold text-green-400 mb-2">
              {projects.filter((p) => p.data.featured).length}
            </div>
            <div class="text-white/70 text-sm">Proyectos destacados</div>
          </div>
        </div>

        <!-- Distribución real de tecnologías -->
        <div class="max-w-4xl mx-auto mb-12 sm:mb-16">
          <TechDistribution username={GITHUB_USERNAME} variant="full" />
        </div>
      </div>
    </section>

    <!-- Dynamic Projects Section -->
    <section class="py-12 sm:py-20">
      <div class="max-w-7xl 2xl:max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">Todos mis Proyectos</h2>
          <p class="text-white/70 text-base sm:text-lg max-w-2xl mx-auto mb-8">
            Proyectos dinámicos actualizados automáticamente desde GitHub con enlaces a repositorios
            y documentación detallada cuando está disponible
          </p>

          <!-- Explicación de estados -->
          <div class="glass rounded-lg p-4 max-w-xl mx-auto mb-8">
            <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-white/70">
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-green-400 rounded-full"></div>
                <span>Con documentación</span>
              </div>
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
                <span>Sin documentación</span>
              </div>
            </div>
            <p class="text-white/60 text-xs mt-2">
              Los repositorios con documentación incluyen enlaces a contenido detallado
            </p>
          </div>

          <!-- Actividad de Contribuciones de GitHub en estilo nativo con cuadritos y estadísticas -->
          <div class="mb-12">
            <GitHubContributionGraph username={GITHUB_USERNAME} />
          </div>
        </div>

        <DynamicProjectCards limit={24} />

        <div class="text-center mt-12">
          <a
            href="https://github.com/xinzayr"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-2 text-blue-400 hover:text-blue-300 font-medium transition-colors"
          >
            <span>Ver más en GitHub</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</BaseLayout>
