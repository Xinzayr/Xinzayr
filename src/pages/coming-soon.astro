---
import BaseLayout from '../layouts/BaseLayoutNew.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="En construcción - xinzayr" description="Esta sección está en desarrollo. Pronto tendrás acceso a nuevo contenido increíble.">
	<Header />

	<main class="min-h-screen pt-16 flex items-center justify-center">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<!-- Construction Animation -->
			<div class="mb-8">
				<div class="relative">
					<!-- Main construction icon -->
					<div class="w-32 h-32 mx-auto bg-gradient-to-br from-yellow-400 to-orange-500 rounded-full flex items-center justify-center mb-6 animate-pulse">
						<svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 7.172V5L8 4z"/>
						</svg>
					</div>

					<!-- Floating tools -->
					<div class="absolute inset-0 pointer-events-none">
						<div class="absolute top-0 left-1/4 animate-bounce" style="animation-delay: 0s;">
							<div class="w-8 h-8 bg-gray-500/20 rounded-lg flex items-center justify-center">
								<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								</svg>
							</div>
						</div>

						<div class="absolute top-1/4 right-1/4 animate-bounce" style="animation-delay: 1s;">
							<div class="w-6 h-6 bg-blue-500/20 rounded-lg flex items-center justify-center">
								<svg class="w-3 h-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM7 3H5a2 2 0 00-2 2v12a4 4 0 004 4h2M9 3h6a2 2 0 012 2v12a4 4 0 01-2 2h-6M9 3v18"/>
								</svg>
							</div>
						</div>

						<div class="absolute bottom-1/4 left-1/3 animate-bounce" style="animation-delay: 2s;">
							<div class="w-7 h-7 bg-green-500/20 rounded-lg flex items-center justify-center">
								<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								</svg>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Message -->
			<h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
				En Construcción
			</h1>

			<p class="text-xl text-white/70 mb-8 max-w-2xl mx-auto">
				Esta sección está actualmente en desarrollo. Estamos implementando nuevas características y mejoras
				que estarán disponibles próximamente para ofrecerte la mejor experiencia posible.
			</p>

			<!-- Progress simulation -->
			<div class="mb-8">
				<div class="glass rounded-lg p-6 max-w-md mx-auto">
					<div class="flex items-center justify-between mb-2">
						<span class="text-white/80 font-medium">Progreso del desarrollo</span>
						<span class="text-purple-400 font-semibold" id="progress-text">0%</span>
					</div>
					<div class="w-full bg-white/10 rounded-full h-3">
						<div
							class="bg-gradient-to-r from-purple-500 to-pink-500 h-3 rounded-full transition-all duration-1000 ease-out"
							id="progress-bar"
							style="width: 0%"
						></div>
					</div>
				</div>
			</div>

			<!-- Features coming soon -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
				<div class="glass rounded-lg p-6">
					<div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center mb-4 mx-auto">
						<svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
						</svg>
					</div>
					<h3 class="text-white font-semibold mb-2">Súper Rápido</h3>
					<p class="text-white/60 text-sm">Optimizado para la mejor experiencia de usuario</p>
				</div>

				<div class="glass rounded-lg p-6">
					<div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center mb-4 mx-auto">
						<svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
						</svg>
					</div>
					<h3 class="text-white font-semibold mb-2">Responsive</h3>
					<p class="text-white/60 text-sm">Perfecto en todos los dispositivos</p>
				</div>

				<div class="glass rounded-lg p-6">
					<div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center mb-4 mx-auto">
						<svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
						</svg>
					</div>
					<h3 class="text-white font-semibold mb-2">Seguro</h3>
					<p class="text-white/60 text-sm">Construido con las mejores prácticas de seguridad</p>
				</div>
			</div>

			<!-- Newsletter signup -->
			<div class="glass rounded-xl p-8 max-w-lg mx-auto mb-8">
				<h3 class="text-xl font-bold text-white mb-4">
					¿Quieres ser el primero en saberlo?
				</h3>
				<p class="text-white/70 mb-6">
					Te notificaremos cuando esta sección esté lista
				</p>
				<div class="flex flex-col sm:flex-row gap-3">
					<input
						type="email"
						placeholder="tu@email.com"
						class="flex-1 px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:border-purple-500 transition-colors"
					>
					<button class="px-6 py-3 bg-purple-500 hover:bg-purple-600 text-white font-medium rounded-lg transition-colors">
						Notificarme
					</button>
				</div>
			</div>

			<!-- Back to site -->
			<div class="mb-8">
				<div class="flex items-center max-w-md mx-auto">
					<div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
					<div class="px-4 text-white/60 text-lg font-medium">¿Te has perdido?</div>
					<div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
				</div>
			</div>

			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<button
					onclick="window.history.back()"
					class="inline-flex items-center space-x-2 px-6 py-3 bg-purple-500 hover:bg-purple-600 text-white font-medium rounded-lg transition-colors"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
					</svg>
					<span>Volver Atrás</span>
				</button>

				<a
					href="/"
					class="inline-flex items-center space-x-2 px-6 py-3 glass border border-white/20 hover:border-white/30 text-white font-medium rounded-lg transition-colors"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
					</svg>
					<span>Ir al Inicio</span>
				</a>

				<a
					href="https://github.com/xinzayr"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center space-x-2 px-6 py-3 glass border border-white/20 hover:border-white/30 text-white font-medium rounded-lg transition-colors"
				>
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
					</svg>
					<span>Te invito a visitar mi GitHub</span>
				</a>
			</div>
		</div>
	</main>

	<Footer />

	<script>
		// Simular progreso de desarrollo
		document.addEventListener('DOMContentLoaded', function() {
			const progressBar = document.getElementById('progress-bar');
			const progressText = document.getElementById('progress-text');

			if (progressBar && progressText) {
				let progress = 0;
				const targetProgress = Math.floor(Math.random() * 30) + 65; // Entre 65% y 95%

				const interval = setInterval(() => {
					progress++;
					progressBar.style.width = progress + '%';
					progressText.textContent = progress + '%';

					if (progress >= targetProgress) {
						clearInterval(interval);
					}
				}, 50);
			}
		});

		// Efecto de partículas en construcción
		function createConstructionParticle() {
			const colors = ['#8B5CF6', '#F59E0B', '#10B981', '#F97316'];
			const particle = document.createElement('div');

			particle.className = 'fixed w-2 h-2 rounded-full pointer-events-none z-10';
			particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
			particle.style.left = Math.random() * window.innerWidth + 'px';
			particle.style.top = window.innerHeight + 'px';
			particle.style.opacity = '0.6';

			document.body.appendChild(particle);

			// Animar hacia arriba
			particle.animate([
				{
					transform: 'translateY(0px) rotate(0deg) scale(1)',
					opacity: 0.6
				},
				{
					transform: `translateY(-${window.innerHeight + 100}px) rotate(360deg) scale(0)`,
					opacity: 0
				}
			], {
				duration: Math.random() * 3000 + 2000,
				easing: 'ease-out'
			}).onfinish = () => particle.remove();
		}

		// Crear partículas cada cierto tiempo
		setInterval(createConstructionParticle, 500);
	</script>
</BaseLayout>
