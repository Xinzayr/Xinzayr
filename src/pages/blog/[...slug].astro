---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import LinkPreview from '../../components/LinkPreview.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} - xinzayr`} description={post.data.description}>
	<Header />

	<main class="min-h-screen pt-16">
		<article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<!-- Hero Image -->
			{post.data.heroImage && (
				<div class="mb-12">
					<div class="relative aspect-video rounded-2xl overflow-hidden glass border border-white/10">
						<img
							src={post.data.heroImage.src}
							alt={post.data.title}
							class="w-full h-full object-cover"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
					</div>
				</div>
			)}

			<!-- Header -->
			<header class="mb-12 text-center">
				<div class="inline-flex items-center gap-2 px-3 py-1 glass rounded-full border border-blue-500/30 text-blue-300 text-xs font-mono mb-4">
					{post.data.category || 'General'}
				</div>

				<h1 class="text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
					{post.data.title}
				</h1>

				<div class="flex flex-wrap items-center justify-center gap-4 text-white/70 text-sm">
					<div class="flex items-center space-x-2">
						<svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
						</svg>
						<span>{post.data.author || 'Xinzaýr'}</span>
					</div>

					<div class="flex items-center space-x-2">
						<svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
						</svg>
						<FormattedDate date={post.data.pubDate} />
					</div>

					{post.data.readingTime && (
						<div class="flex items-center space-x-2 text-blue-300 font-mono">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
							</svg>
							<span>{post.data.readingTime}</span>
						</div>
					)}

					{post.data.tags && post.data.tags.length > 0 && (
						<div class="flex flex-wrap gap-2 ml-2">
							{post.data.tags.map((tag) => (
								<a href={`/blog#tag-${tag}`} class="px-2.5 py-0.5 text-xs bg-blue-500/20 text-blue-300 rounded-full font-mono hover:bg-blue-500/40 transition-colors">
									#{tag}
								</a>
							))}
						</div>
					)}
				</div>
			</header>

			<!-- Content -->
			<div class="prose prose-invert prose-lg max-w-none">
				<div class="glass rounded-2xl p-8 lg:p-12 border border-white/10 shadow-2xl backdrop-blur-xl">
					<Content />
				</div>
			</div>

			<!-- Navigation & Actions -->
			<nav class="mt-16 pt-8 border-t border-white/10">
				<div class="flex flex-col sm:flex-row justify-between items-center gap-4">
					<a
						href="/blog"
						class="inline-flex items-center space-x-2 px-5 py-2.5 glass border border-white/20 text-white rounded-xl glass-hover font-medium transition-all"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
						</svg>
						<span>Volver a la Biblioteca</span>
					</a>

					<div class="flex items-center space-x-4">
						<button
							onclick="navigator.share && navigator.share({title: document.title, url: window.location.href}) || (navigator.clipboard.writeText(window.location.href) && alert('¡Enlace copiado al portapapeles!'))"
							class="inline-flex items-center gap-2 px-4 py-2.5 glass border border-white/20 text-white rounded-xl glass-hover text-sm font-medium transition-all"
							title="Compartir artículo"
						>
							<svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"/>
							</svg>
							<span>Compartir</span>
						</button>
					</div>
				</div>
			</nav>
		</article>
	</main>

	<!-- Componente Flotante para Vistas Previas al pasar el cursor -->
	<LinkPreview />

	<Footer />
</BaseLayout>

<style>
	/* Custom prose styles for Liquid Glass */
	.prose {
		@apply text-white/90;
	}

	.prose h1,
	.prose h2,
	.prose h3,
	.prose h4,
	.prose h5,
	.prose h6 {
		@apply text-white font-bold tracking-tight;
	}

	.prose h2 {
		@apply text-2xl lg:text-3xl mt-10 mb-4 pb-2 border-b border-white/10;
	}

	.prose h3 {
		@apply text-xl lg:text-2xl mt-8 mb-3 text-blue-300;
	}

	.prose p {
		@apply text-white/80 leading-relaxed mb-6 font-normal;
	}

	.prose a {
		@apply text-blue-400 hover:text-blue-300 underline underline-offset-4 decoration-blue-500/40 transition-colors;
	}

	.prose code {
		@apply bg-white/10 text-blue-300 px-2 py-0.5 rounded font-mono text-sm border border-white/10;
	}

	.prose pre {
		@apply bg-slate-950/80 border border-white/15 rounded-xl p-5 overflow-x-auto shadow-xl my-6;
	}

	.prose pre code {
		@apply bg-transparent p-0 border-none text-slate-200;
	}

	.prose blockquote {
		@apply border-l-4 border-blue-500 pl-4 py-1 my-6 italic text-white/80 bg-blue-500/5 rounded-r-lg;
	}

	.prose ul,
	.prose ol {
		@apply text-white/80 my-6 pl-6;
	}

	.prose ul {
		@apply list-disc;
	}

	.prose ol {
		@apply list-decimal;
	}

	.prose li {
		@apply mb-2 leading-relaxed;
	}

	.prose strong {
		@apply text-white font-semibold;
	}

	.prose table {
		@apply w-full border-collapse my-6 overflow-hidden rounded-xl border border-white/10;
	}

	.prose th,
	.prose td {
		@apply border border-white/10 px-4 py-3 text-sm;
	}

	.prose th {
		@apply bg-white/10 font-semibold text-white text-left;
	}

	.prose td {
		@apply bg-white/5 text-white/80;
	}
</style>
