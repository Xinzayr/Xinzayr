---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import BloggerPosts from '../../components/BloggerPosts.astro';
import { API_CONFIG } from '../../consts';

// Obtener todos los posts locales desde src/content/blog/
const rawLocalPosts = await getCollection('blog');
const localPosts = rawLocalPosts
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Extraer todas las etiquetas únicas
const allTags = Array.from(
	new Set(localPosts.flatMap((post) => post.data.tags || []))
).sort();
---

<BaseLayout title="Blog & Digital Garden - xinzayr" description="Artículos, notas interconectadas y documentación en Markdown/MDX.">
	<Header />

	<main class="min-h-screen pt-16">
		<!-- Hero Section -->
		<section class="py-20">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<div class="inline-flex items-center gap-2 px-3 py-1 glass rounded-full border border-blue-500/30 text-blue-300 text-xs font-mono mb-4">
						<span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
						Digital Garden & Biblioteca MDX
					</div>
					<h1 class="text-4xl lg:text-5xl font-bold text-white mb-6">
						Mi Blog & Bitácora
					</h1>
					<p class="text-white/70 text-lg max-w-2xl mx-auto mb-8">
						Explora mis notas, tutoriales y reflexiones interconectadas. Al abrir cualquier artículo podrás hacer hover sobre las citas estilo Obsidian [[wikilinks]] para ver vistas previas flotantes.
					</p>

					<!-- Tag Filter Pills -->
					{allTags.length > 0 && (
						<div class="flex flex-wrap justify-center gap-2 max-w-3xl mx-auto mb-8">
							<span class="text-xs text-white/50 self-center font-mono mr-2">Filtros:</span>
							{allTags.map((tag) => (
								<a
									href={`#tag-${tag}`}
									data-tag-btn={tag}
									class="tag-filter-btn px-3 py-1 text-xs glass border border-white/10 text-white/80 hover:text-white hover:border-blue-400/50 rounded-full transition-all duration-200"
								>
									#{tag}
								</a>
							))}
						</div>
					)}
				</div>

				<!-- Local MDX / MD Posts Section -->
				<div class="mb-20">
					<div class="flex items-center justify-between mb-8">
						<div>
							<h2 class="text-2xl font-bold text-white flex items-center gap-2">
								<svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
								</svg>
								Biblioteca de Contenidos ({localPosts.length})
							</h2>
							<p class="text-white/60 text-sm mt-1">
								Artículos locales creados en Markdown/MDX con soporte para enlaces bidireccionales.
							</p>
						</div>
					</div>

					{localPosts.length > 0 ? (
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="posts-grid">
							{localPosts.map((post) => (
								<div data-post-tags={JSON.stringify(post.data.tags || [])}>
									<BlogCard
										title={post.data.title}
										description={post.data.description}
										pubDate={post.data.pubDate}
										heroImage={post.data.heroImage?.src}
										tags={post.data.tags}
										href={`/blog/${post.id}`}
									/>
								</div>
							))}
						</div>
					) : (
						<div class="glass rounded-xl p-8 text-center max-w-md mx-auto">
							<p class="text-white/60 text-sm">No hay artículos publicados en la carpeta local aún.</p>
						</div>
					)}
				</div>

				<!-- Separador -->
				<div class="my-16 flex items-center">
					<div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
					<div class="px-4 text-white/60 text-sm font-medium">Sincronización Externa</div>
					<div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
				</div>

				<!-- Blogger RSS Feed Section -->
				<div>
					<div class="text-center mb-8">
						<h2 class="text-2xl font-bold text-white mb-2">Feed de Blogger</h2>
						<div class="flex items-center justify-center gap-2 text-sm text-white/60">
							<span>Sincronizado desde</span>
							<a
								href={API_CONFIG.blogger.blogUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="text-blue-400 hover:text-blue-300 transition-colors"
							>
								blog.xinzayr.xyz
							</a>
						</div>
					</div>

					<BloggerPosts variant="featured" maxPosts={6} showFeatured={false} />
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<script>
	function setupTagFilter() {
		const tagBtns = document.querySelectorAll('.tag-filter-btn');
		const postItems = document.querySelectorAll('#posts-grid > div');

		tagBtns.forEach((btn) => {
			btn.addEventListener('click', (e) => {
				const tag = btn.getAttribute('data-tag-btn');
				if (!tag) return;

				const isActive = btn.classList.contains('bg-blue-500/30');

				tagBtns.forEach((b) => b.classList.remove('bg-blue-500/30', 'border-blue-400'));

				if (!isActive) {
					btn.classList.add('bg-blue-500/30', 'border-blue-400');
					postItems.forEach((item) => {
						const itemTags = JSON.parse(item.getAttribute('data-post-tags') || '[]');
						if (itemTags.includes(tag)) {
							(item as HTMLElement).style.display = 'block';
						} else {
							(item as HTMLElement).style.display = 'none';
						}
					});
				} else {
					postItems.forEach((item) => ((item as HTMLElement).style.display = 'block'));
				}
			});
		});
	}

	document.addEventListener('astro:page-load', setupTagFilter);
	setupTagFilter();
</script>
