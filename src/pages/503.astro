---
import BaseLayout from '../layouts/BaseLayoutNew.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Servicios no disponibles - xinzayr" description="Los servicios solicitados están temporalmente no disponibles. Vuelve pronto para más actualizaciones.">
	<Header />

	<main class="min-h-screen pt-16 flex items-center justify-center">
		<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<!-- Icon -->
			<div class="mb-8">
				<div class="w-24 h-24 mx-auto bg-gradient-to-br from-orange-400 to-red-500 rounded-full flex items-center justify-center mb-6">
					<svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.664-.833-2.464 0L4.35 16.5c-.77.833.192 2.5 1.732 2.5z"/>
					</svg>
				</div>
			</div>

			<!-- Message -->
			<h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
				Servicio no disponible
			</h1>

			<p class="text-lg text-white/70 mb-8">
				El servicio que intentas acceder está temporalmente no disponible debido a mantenimiento programado o sobrecarga del servidor.
				Nuestro equipo está trabajando para restablecerlo lo antes posible.
			</p>

			<!-- Status indicators -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
				<div class="glass rounded-lg p-4">
					<div class="flex items-center space-x-3">
						<div class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
						<span class="text-white/80">Sitio principal</span>
						<span class="text-green-400 text-sm">Operativo</span>
					</div>
				</div>

				<div class="glass rounded-lg p-4">
					<div class="flex items-center space-x-3">
						<div class="w-3 h-3 bg-orange-400 rounded-full animate-pulse"></div>
						<span class="text-white/80">Servicios adicionales</span>
						<span class="text-orange-400 text-sm">Mantenimiento</span>
					</div>
				</div>
			</div>

			<!-- Separator -->
			<div class="mb-8">
				<div class="flex items-center max-w-md mx-auto">
					<div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
					<div class="px-4 text-white/60 text-lg font-medium">¿Te has perdido?</div>
					<div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
				</div>
			</div>

			<!-- Actions -->
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<button
					onclick="window.history.back()"
					class="inline-flex items-center space-x-2 px-6 py-3 bg-purple-500 hover:bg-purple-600 text-white font-medium rounded-lg transition-colors"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
					</svg>
					<span>Volver Atrás</span>
				</button>

				<a
					href="/"
					class="inline-flex items-center space-x-2 px-6 py-3 glass border border-white/20 hover:border-white/30 text-white font-medium rounded-lg transition-colors"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
					</svg>
					<span>Ir al Inicio</span>
				</a>

				<a
					href="https://github.com/xinzayr"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center space-x-2 px-6 py-3 glass border border-white/20 hover:border-white/30 text-white font-medium rounded-lg transition-colors"
				>
					<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
					</svg>
					<span>Te invito a visitar mi GitHub</span>
				</a>
			</div>
		</div>
	</main>

	<Footer />
</BaseLayout>
