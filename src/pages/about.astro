---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProfileInfo from '../components/ProfileInfo.astro';
import GitHubStats from '../components/GitHubStats.astro';
import { EXTERNAL_RESOURCES } from '../consts';
---

<BaseLayout title="Acerca de mí - xinzayr" description="Conoce más sobre mi proceso de aprendizaje, habilidades técnicas y trayectoria como desarrollador junior en crecimiento.">
	<Header />

	<main class="min-h-screen pt-16 pb-8">
		<!-- Hero Section -->
		<section class="py-12 lg:py-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
						Sobre mí
					</h1>
					<p class="text-lg sm:text-xl text-white/80 max-w-3xl mx-auto leading-relaxed">
						Desarrollador junior apasionado por crear experiencias web modernas y aprender nuevas tecnologías cada día.
					</p>
				</div>

				<!-- Perfil completo con información múltiple -->
				<ProfileInfo variant="complete" showQR={true} />
			</div>
		</section>

		<!-- GitHub Stats Section -->
		<section class="py-12 lg:py-16 bg-white/5 backdrop-blur-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
						Estadísticas de GitHub
					</h2>
					<p class="text-white/70 text-lg max-w-2xl mx-auto">
						Datos reales de mi actividad y contribuciones en GitHub
					</p>
				</div>

				<GitHubStats variant="detailed" />
			</div>
		</section>

		<!-- Skills Section Responsiva -->
		<section class="py-12 lg:py-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
						Habilidades Técnicas en Desarrollo
					</h2>
					<p class="text-white/70 text-lg max-w-2xl mx-auto">
						Tecnologías que estoy aprendiendo y dominando progresivamente
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8">
					<!-- Frontend -->
					<div class="glass rounded-xl p-6 lg:p-8">
						<h3 class="text-xl font-bold text-white mb-6 flex items-center">
							<div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mr-3">
								<svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
								</svg>
							</div>
							Frontend
						</h3>
						<div class="space-y-4">
							{[
								{ name: 'HTML/CSS', level: 90, desc: 'Fundamentos sólidos' },
								{ name: 'JavaScript', level: 85, desc: 'ES6+ y DOM' },
								{ name: 'TypeScript', level: 80, desc: 'En aprendizaje' },
								{ name: 'React', level: 75, desc: 'Hooks y componentes' },
								{ name: 'TailwindCSS', level: 90, desc: 'Utility-first CSS' },
								{ name: 'Astro', level: 70, desc: 'Framework moderno' },
							].map((skill) => (
								<div class="space-y-2">
									<div class="flex justify-between items-end">
										<div>
											<span class="text-white/90 text-sm font-medium">{skill.name}</span>
											<p class="text-white/50 text-xs">{skill.desc}</p>
										</div>
										<span class="text-blue-400 text-sm font-mono">{skill.level}%</span>
									</div>
									<div class="w-full bg-white/10 rounded-full h-2">
										<div
											class="bg-gradient-to-r from-blue-500 to-blue-400 h-2 rounded-full transition-all duration-1000 ease-out"
											style={`width: ${skill.level}%`}
										></div>
									</div>
								</div>
							))}
						</div>
					</div>

					<!-- Backend -->
					<div class="glass rounded-xl p-6 lg:p-8">
						<h3 class="text-xl font-bold text-white mb-6 flex items-center">
							<div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center mr-3">
								<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
								</svg>
							</div>
							Backend
						</h3>
						<div class="space-y-4">
							{[
								{ name: 'Node.js', level: 75, desc: 'Runtime y módulos' },
								{ name: 'Python', level: 80, desc: 'Scripting y APIs' },
								{ name: 'Express.js', level: 70, desc: 'APIs REST' },
								{ name: 'FastAPI', level: 65, desc: 'Python moderno' },
								{ name: 'SQL', level: 65, desc: 'Bases de datos' },
								{ name: 'Git', level: 85, desc: 'Control de versiones' },
							].map((skill) => (
								<div class="space-y-2">
									<div class="flex justify-between items-end">
										<div>
											<span class="text-white/90 text-sm font-medium">{skill.name}</span>
											<p class="text-white/50 text-xs">{skill.desc}</p>
										</div>
										<span class="text-green-400 text-sm font-mono">{skill.level}%</span>
									</div>
									<div class="w-full bg-white/10 rounded-full h-2">
										<div
											class="bg-gradient-to-r from-green-500 to-green-400 h-2 rounded-full transition-all duration-1000 ease-out"
											style={`width: ${skill.level}%`}
										></div>
									</div>
								</div>
							))}
						</div>
					</div>

					<!-- Tools & Learning -->
					<div class="glass rounded-xl p-6 lg:p-8 md:col-span-2 xl:col-span-1">
						<h3 class="text-xl font-bold text-white mb-6 flex items-center">
							<div class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center mr-3">
								<svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
								</svg>
							</div>
							Herramientas y Aprendizaje
						</h3>
						<div class="space-y-4">
							{[
								{ name: 'VS Code', level: 95, desc: 'Editor principal' },
								{ name: 'Terminal/CLI', level: 80, desc: 'Línea de comandos' },
								{ name: 'GitHub', level: 85, desc: 'Colaboración' },
								{ name: 'Vercel/Netlify', level: 75, desc: 'Despliegue' },
								{ name: 'Figma', level: 60, desc: 'Diseño UI/UX' },
								{ name: 'Docker', level: 50, desc: 'Contenedores (aprendiendo)' },
							].map((skill) => (
								<div class="space-y-2">
									<div class="flex justify-between items-end">
										<div>
											<span class="text-white/90 text-sm font-medium">{skill.name}</span>
											<p class="text-white/50 text-xs">{skill.desc}</p>
										</div>
										<span class="text-purple-400 text-sm font-mono">{skill.level}%</span>
									</div>
									<div class="w-full bg-white/10 rounded-full h-2">
										<div
											class="bg-gradient-to-r from-purple-500 to-purple-400 h-2 rounded-full transition-all duration-1000 ease-out"
											style={`width: ${skill.level}%`}
										></div>
									</div>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Experience Timeline Responsiva -->
		<section class="py-12 lg:py-20 bg-white/5 backdrop-blur-sm">
			<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
						Mi Trayectoria de Aprendizaje
					</h2>
					<p class="text-white/70 text-lg max-w-2xl mx-auto">
						El camino que he recorrido para convertirme en desarrollador
					</p>
				</div>

				<div class="relative">
					<!-- Timeline line -->
					<div class="absolute left-4 lg:left-1/2 transform lg:-translate-x-1/2 w-0.5 h-full bg-gradient-to-b from-blue-500 to-purple-500 rounded-full"></div>

					<!-- Timeline items -->
					<div class="space-y-8 lg:space-y-12">
						{[
							{
								year: '2025',
								title: 'Desarrollador Junior Freelance',
								company: 'Proyectos independientes',
								description: 'Desarrollo de proyectos web personales y colaboraciones. Enfoque en crear interfaces limpias y funcionales mientras aprendo las mejores prácticas de la industria.',
								skills: ['React', 'TypeScript', 'Astro', 'TailwindCSS', 'Node.js'],
								current: true
							},
							{
								year: '2024',
								title: 'Profundización en Desarrollo Full Stack',
								company: 'Aprendizaje autodidacta',
								description: 'Expansión hacia tecnologías backend, APIs REST, bases de datos y herramientas de desarrollo modernas. Creación de proyectos completos de principio a fin.',
								skills: ['FastAPI', 'Python', 'PostgreSQL', 'Docker', 'Git'],
								current: false
							},
							{
								year: '2023',
								title: 'Fundamentos de Desarrollo Web',
								company: 'Formación autodidacta',
								description: 'Primeros pasos en programación web. Aprendizaje de HTML, CSS, JavaScript y los conceptos fundamentales del desarrollo frontend.',
								skills: ['HTML', 'CSS', 'JavaScript', 'Responsive Design'],
								current: false
							}
						].map((item, index) => (
							<div class={`relative flex flex-col lg:flex-row items-start ${index % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'}`}>
								<!-- Timeline dot -->
								<div class={`absolute left-4 lg:left-1/2 transform -translate-x-1/2 z-10 ${
									item.current
										? 'w-6 h-6 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full border-4 border-black animate-pulse'
										: 'w-4 h-4 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full border-4 border-black'
								}`}>
									{item.current && (
										<div class="absolute inset-1 bg-white rounded-full animate-ping"></div>
									)}
								</div>

								<!-- Content -->
								<div class={`ml-12 lg:ml-0 lg:w-1/2 ${index % 2 === 0 ? 'lg:pr-8' : 'lg:pl-8'}`}>
									<div class="glass rounded-xl p-6 lg:p-8 relative">
										{item.current && (
											<div class="absolute -top-2 -right-2 bg-gradient-to-r from-blue-500 to-purple-500 text-white text-xs px-2 py-1 rounded-full font-medium">
												Actual
											</div>
										)}
										<div class="flex items-center justify-between mb-3">
											<span class="text-blue-400 font-mono text-sm lg:text-base font-medium">{item.year}</span>
										</div>
										<h3 class="text-lg lg:text-xl font-bold text-white mb-2">{item.title}</h3>
										<p class="text-purple-400 text-sm mb-4">{item.company}</p>
										<p class="text-white/70 text-sm lg:text-base mb-6 leading-relaxed">{item.description}</p>
										<div class="flex flex-wrap gap-2">
											{item.skills.map((skill) => (
												<span class="px-3 py-1 text-xs lg:text-sm bg-white/10 text-white/80 rounded-full font-mono hover:bg-white/20 transition-colors">
													{skill}
												</span>
											))}
										</div>
									</div>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- Learning Goals Section -->
		<section class="py-12 lg:py-20">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
						Objetivos de Aprendizaje 2025
					</h2>
					<p class="text-white/70 text-lg max-w-2xl mx-auto">
						Tecnologías y habilidades que planeo dominar este año
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{[
						{
							icon: '🎯',
							title: 'React Avanzado',
							description: 'Dominar patrones avanzados, Context API, y optimización de rendimiento',
							progress: 60
						},
						{
							icon: '🐳',
							title: 'DevOps Básico',
							description: 'Docker, CI/CD, y conceptos de infraestructura para desarrolladores',
							progress: 30
						},
						{
							icon: '📱',
							title: 'Desarrollo Mobile',
							description: 'React Native o Flutter para aplicaciones multiplataforma',
							progress: 20
						},
						{
							icon: '🔒',
							title: 'Seguridad Web',
							description: 'Buenas prácticas de seguridad, autenticación y autorización',
							progress: 40
						},
						{
							icon: '📊',
							title: 'Bases de Datos',
							description: 'PostgreSQL avanzado, MongoDB y optimización de consultas',
							progress: 50
						},
						{
							icon: '🎨',
							title: 'UI/UX Design',
							description: 'Principios de diseño, Figma avanzado y prototipado',
							progress: 35
						}
					].map((goal) => (
						<div class="glass rounded-xl p-6 hover:bg-white/10 transition-colors">
							<div class="text-3xl mb-4">{goal.icon}</div>
							<h3 class="text-lg font-semibold text-white mb-3">{goal.title}</h3>
							<p class="text-white/70 text-sm mb-4 leading-relaxed">{goal.description}</p>
							<div class="space-y-2">
								<div class="flex justify-between items-center">
									<span class="text-white/60 text-xs">Progreso actual</span>
									<span class="text-blue-400 text-xs font-mono">{goal.progress}%</span>
								</div>
								<div class="w-full bg-white/10 rounded-full h-2">
									<div
										class="bg-gradient-to-r from-blue-500 to-purple-500 h-2 rounded-full transition-all duration-1000"
										style={`width: ${goal.progress}%`}
									></div>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Contact CTA -->
		<section class="py-12 lg:py-16 bg-white/5 backdrop-blur-sm">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<div class="glass rounded-xl p-8 lg:p-12">
					<h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
						¿Interesado en colaborar?
					</h2>
					<p class="text-white/70 text-lg mb-8 max-w-2xl mx-auto">
						Estoy abierto a oportunidades de aprendizaje, proyectos colaborativos
						y mentorías que me ayuden a crecer como desarrollador.
					</p>

					<div class="flex flex-col sm:flex-row gap-4 justify-center">
						<a
							href="/contact"
							class="inline-flex items-center justify-center space-x-2 px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-500 text-white font-medium rounded-lg hover:from-blue-600 hover:to-purple-600 transition-all transform hover:scale-105"
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
							<span>Contactar</span>
						</a>

						<a
							href="https://github.com/xinzayr"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center space-x-2 px-8 py-4 glass border border-white/20 text-white font-medium rounded-lg glass-hover"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
							</svg>
							<span>Ver GitHub</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<style>
	.glass {
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.glass-hover {
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.glass-hover:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
	}

	@keyframes pulse {
		0%, 100% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
	}

	.animate-pulse {
		animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
	}

	@keyframes ping {
		75%, 100% {
			transform: scale(2);
			opacity: 0;
		}
	}

	.animate-ping {
		animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	/* Responsive text clamping */
	@supports (display: -webkit-box) {
		.line-clamp-2 {
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}

	/* Responsive spacing */
	@media (max-width: 640px) {
		.glass {
			margin: 0 0.5rem;
		}
	}
</style>
