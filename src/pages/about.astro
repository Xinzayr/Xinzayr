---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProfileInfo from '../components/ProfileInfo.astro';
import GitHubStats from '../components/GitHubStats.astro';
import GitHubRepos from '../components/GitHubRepos.astro';
import WindowsEmoji from '../components/WindowsEmoji.astro';
import { EXTERNAL_RESOURCES } from '../consts';
---

<BaseLayout
  title="Acerca de mí - xinzayr"
  description="Conoce más sobre mi proceso de aprendizaje, habilidades técnicas y trayectoria como desarrollador junior en crecimiento."
>
  <Header />

  <main class="min-h-screen pt-16 pb-8">
    <!-- Hero Section -->
    <section class="py-12 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">Sobre mí</h1>
          <p class="text-lg sm:text-xl text-white/80 max-w-3xl mx-auto leading-relaxed">
            Desarrollador junior que busca crear por y para la comunidad, soluciones resistentes
            ante cambios y movimientos desfavorables para la sociedad, casos vistos actualmente por
            las censuras.
          </p>
        </div>

        <!-- Perfil completo con información múltiple -->
        <ProfileInfo variant="complete" showQR={true} />
      </div>
    </section>

    <!-- GitHub Stats Section -->
    <section class="py-12 lg:py-16 bg-white/5 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
            Estadísticas de GitHub
          </h2>
          <p class="text-white/70 text-lg max-w-2xl mx-auto">
            Datos sobre mi actividad y contribuciones en GitHub
          </p>
        </div>

        <GitHubStats variant="detailed" />
      </div>
    </section>

    <!-- Simple GitHub Repos Preview Section -->
    <section class="py-12 lg:py-20 bg-white/5 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
            Mis Repositorios Recientes
          </h2>
          <p class="text-white/70 text-lg max-w-2xl mx-auto">
            Una vista rápida a mis repositorios más recientes en GitHub
          </p>
        </div>

        <GitHubRepos variant="featured" limit={6} />

        <div class="text-center mt-8">
          <a
            href="/projects"
            class="inline-flex items-center space-x-2 text-blue-400 hover:text-blue-300 font-medium transition-colors"
          >
            <span>Ver todos los proyectos</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="py-12 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
            Habilidades Técnicas en Desarrollo
          </h2>
          <p class="text-white/70 text-lg max-w-2xl mx-auto">
            Tecnologías que estoy aprendiendo y dominando progresivamente
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8">
          <!-- Lenguajes y Fundamentos -->
          <div class="glass rounded-xl p-6 lg:p-8">
            <h3 class="text-xl font-bold text-white mb-6 flex items-center">
              <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mr-3">
                <svg
                  class="w-4 h-4 text-blue-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
              </div>
              Lenguajes y Fundamentos
            </h3>
            <div class="space-y-4">
              {
                [
                  { name: 'JavaScript', level: 60, desc: 'Base del desarrollo web' },
                  { name: 'TypeScript', level: 80, desc: 'Tipado estático' },
                  { name: 'Python', level: 70, desc: 'Scripting y automatización' },
                  { name: 'HTML/CSS', level: 100, desc: 'Estructura y estilos' },
                  { name: 'Java', level: 50, desc: 'Programación orientada a objetos' },
                  { name: 'Rust', level: 50, desc: 'Sistemas seguros' },
                ].map((skill) => (
                  <div class="space-y-2">
                    <div class="flex justify-between items-end">
                      <div>
                        <span class="text-white/90 text-sm font-medium">{skill.name}</span>
                        <p class="text-white/50 text-xs">{skill.desc}</p>
                      </div>
                      <span class="text-blue-400 text-sm font-mono">{skill.level}%</span>
                    </div>
                    <div class="w-full bg-white/10 rounded-full h-2">
                      <div
                        class="bg-gradient-to-r from-blue-500 to-blue-400 h-2 rounded-full transition-all duration-1000 ease-out"
                        style={`width: ${skill.level}%`}
                      />
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Frameworks y Servicios -->
          <div class="glass rounded-xl p-6 lg:p-8">
            <h3 class="text-xl font-bold text-white mb-6 flex items-center">
              <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center mr-3">
                <svg
                  class="w-4 h-4 text-green-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                  ></path>
                </svg>
              </div>
              Frameworks y Servicios
            </h3>
            <div class="space-y-4">
              {
                [
                  { name: 'React', level: 50, desc: 'Interfaces de usuario' },
                  { name: 'Astro', level: 70, desc: 'Sitios estáticos' },
                  { name: 'Node.js', level: 60, desc: 'Runtime servidor' },
                  { name: 'Next.js', level: 70, desc: 'Framework React' },
                  { name: 'TailwindCSS', level: 70, desc: 'Estilos utilitarios' },
                  { name: 'Deno', level: 40, desc: 'Runtime moderno' },
                ].map((skill) => (
                  <div class="space-y-2">
                    <div class="flex justify-between items-end">
                      <div>
                        <span class="text-white/90 text-sm font-medium">{skill.name}</span>
                        <p class="text-white/50 text-xs">{skill.desc}</p>
                      </div>
                      <span class="text-green-400 text-sm font-mono">{skill.level}%</span>
                    </div>
                    <div class="w-full bg-white/10 rounded-full h-2">
                      <div
                        class="bg-gradient-to-r from-green-500 to-green-400 h-2 rounded-full transition-all duration-1000 ease-out"
                        style={`width: ${skill.level}%`}
                      />
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Herramientas y Ecosistema -->
          <div class="glass rounded-xl p-6 lg:p-8 md:col-span-2 xl:col-span-1">
            <h3 class="text-xl font-bold text-white mb-6 flex items-center">
              <div
                class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center mr-3"
              >
                <svg
                  class="w-4 h-4 text-purple-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                  ></path>
                </svg>
              </div>
              Herramientas y Ecosistema
            </h3>
            <div class="space-y-4">
              {
                [
                  { name: 'VS Code', level: 95, desc: 'Editor indispensable' },
                  { name: 'Git & GitHub', level: 85, desc: 'Control de versiones' },
                  { name: 'Terminal/CLI', level: 80, desc: 'Línea de comandos' },
                  { name: 'Docker', level: 50, desc: 'Contenedorización' },
                  { name: 'Postman', level: 75, desc: 'Testing APIs' },
                  { name: 'GitHub Copilot', level: 90, desc: 'Asistente AI' },
                  { name: 'PowerShell', level: 19, desc: 'Scripts Windows' },
                  { name: 'Bash', level: 20, desc: 'Scripts Unix/Linux' },
                ].map((skill) => (
                  <div class="space-y-2">
                    <div class="flex justify-between items-end">
                      <div>
                        <span class="text-white/90 text-sm font-medium">{skill.name}</span>
                        <p class="text-white/50 text-xs">{skill.desc}</p>
                      </div>
                      <span class="text-purple-400 text-sm font-mono">{skill.level}%</span>
                    </div>
                    <div class="w-full bg-white/10 rounded-full h-2">
                      <div
                        class="bg-gradient-to-r from-purple-500 to-purple-400 h-2 rounded-full transition-all duration-1000 ease-out"
                        style={`width: ${skill.level}%`}
                      />
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission and Values Section -->
    <section class="py-12 lg:py-20 bg-white/5 backdrop-blur-sm">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
            Misión y Valores
          </h2>
          <p class="text-white/70 text-lg max-w-2xl mx-auto">
            Lo que me motiva y guía en mi crecimiento como desarrollador
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Misión Principal -->
          <div class="glass rounded-xl p-8">
            <div class="flex items-center mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-r from-red-500 to-orange-500 rounded-full flex items-center justify-center mr-4"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">Libertad Digital & Privacidad</h3>
            </div>
            <p class="text-white/80 leading-relaxed">
              Cada tecnología que aprendo está orientada a crear herramientas que protejan la
              privacidad, eviten la censura y garanticen el acceso libre a la información. Mi
              objetivo es contribuir a un internet más seguro y descentralizado.
            </p>
          </div>

          <!-- Enfoque de Desarrollo -->
          <div class="glass rounded-xl p-8">
            <div class="flex items-center mb-6">
              <div
                class="w-12 h-12 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center mr-4"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">Desarrollo Responsable</h3>
            </div>
            <p class="text-white/80 leading-relaxed">
              Busco crear soluciones resistentes a los cambios desfavorables para la sociedad. Cada
              proyecto que desarrollo tiene como base la resistencia ante la censura y la
              preservación de los derechos digitales fundamentales.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Security & Privacy Focus -->
    <section class="py-12 lg:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
            🔐 Seguridad & Privacidad
          </h2>
          <p class="text-white/70 text-lg max-w-2xl mx-auto">
            Áreas de especialización en desarrollo de herramientas de privacidad
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="glass rounded-xl p-8 hover:bg-white/10 transition-all duration-300">
            <div class="text-4xl mb-6"><WindowsEmoji emoji="🦀" /></div>
            <h3 class="text-xl font-bold text-white mb-4">Rust para Sistemas Seguros</h3>
            <p class="text-white/70 mb-4">
              Desarrollo en Rust enfocado en seguridad de memoria, concurrencia y protocolos de red
              seguros.
            </p>
            <div class="text-sm text-white/60">
              <p>• Gestión segura de memoria</p>
              <p>• Programación de redes</p>
              <p>• Protocolos criptográficos</p>
            </div>
          </div>

          <div class="glass rounded-xl p-8 hover:bg-white/10 transition-all duration-300">
            <div class="text-4xl mb-6"><WindowsEmoji emoji="🛡️" /></div>
            <h3 class="text-xl font-bold text-white mb-4">Herramientas de Privacidad</h3>
            <p class="text-white/70 mb-4">
              Desarrollo de aplicaciones que protejan la privacidad y faciliten el acceso anónimo a
              la información.
            </p>
            <div class="text-sm text-white/60">
              <p>• Kill switches y firewalls</p>
              <p>• Protocolos de anonimato</p>
              <p>• Enrutamiento seguro</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Emerging Technologies -->
    <section class="py-12 lg:py-20 bg-white/5 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">
            🚀 Tecnologías Emergentes
          </h2>
          <p class="text-white/70 text-lg max-w-2xl mx-auto">
            Explorando nuevas tecnologías para el futuro del desarrollo
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
          {
            [
              {
                icon: '🌐',
                title: 'Blockchain & Web3',
                description: 'Tecnologías descentralizadas para la libertad digital',
              },
              {
                icon: '📱',
                title: 'Swift para iOS',
                description: 'Desarrollo de aplicaciones móviles de privacidad',
              },
              {
                icon: '🧮',
                title: 'Haskell',
                description: 'Programación funcional para algoritmos seguros',
              },
              {
                icon: '🐳',
                title: 'DevOps Avanzado',
                description: 'Despliegue automatizado y seguro',
              },
            ].map((tech) => (
              <div class="glass rounded-xl p-6 hover:bg-white/10 transition-all duration-300">
                <div class="text-3xl mb-4">
                  <WindowsEmoji emoji={tech.icon} />
                </div>
                <h4 class="text-lg font-semibold text-white mb-2">{tech.title}</h4>
                <p class="text-white/70 text-sm leading-relaxed">{tech.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="py-12 lg:py-16 bg-white/5 backdrop-blur-sm">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="glass rounded-xl p-8 lg:p-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">¿Interesado en colaborar?</h2>
          <p class="text-white/70 text-lg mb-8 max-w-2xl mx-auto">
            Estoy abierto a oportunidades de aprendizaje, proyectos colaborativos y mentorías que me
            ayuden a crecer como desarrollador.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="inline-flex items-center justify-center space-x-2 px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-500 text-white font-medium rounded-lg hover:from-blue-600 hover:to-purple-600 transition-all transform hover:scale-105"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              <span>Contactar</span>
            </a>

            <a
              href="https://github.com/xinzayr"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center space-x-2 px-8 py-4 glass border border-white/20 text-white font-medium rounded-lg glass-hover"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
              <span>Ver GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .glass {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .glass-hover {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glass-hover:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  /* Responsive text clamping */
  @supports (display: -webkit-box) {
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
