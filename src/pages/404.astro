---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="404 - Página no encontrada - xinzayr"
  description="La página que buscas no existe. Regresa al inicio y explora todo lo que tengo para ofrecerte."
>
  <Header />

  <main class="min-h-screen pt-24 pb-16 flex items-center justify-center relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- Animated 404 -->
      <div class="mb-8">
        <div class="relative inline-block">
          <!-- Main 404 Number -->
          <h1
            class="text-[7rem] sm:text-[10rem] md:text-[14rem] font-display font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400 leading-none select-none drop-shadow-2xl"
          >
            404
          </h1>

          <!-- Floating elements -->
          <div
            class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 pointer-events-none w-full h-full"
          >
            <div class="relative w-full h-full">
              <!-- Orbiting dots -->
              <div class="absolute inset-0 animate-spin-slow">
                <div
                  class="w-3 h-3 bg-cyber-cyan rounded-full absolute -top-4 left-1/2 transform -translate-x-1/2 shadow-lg shadow-cyber-cyan/50"
                >
                </div>
                <div
                  class="w-2 h-2 bg-cyber-green rounded-full absolute top-1/2 -right-4 transform -translate-y-1/2 shadow-lg shadow-cyber-green/50"
                >
                </div>
                <div
                  class="w-3 h-3 bg-cyan-300 rounded-full absolute -bottom-4 left-1/2 transform -translate-x-1/2 shadow-lg shadow-cyan-300/50"
                >
                </div>
                <div
                  class="w-2 h-2 bg-emerald-400 rounded-full absolute top-1/2 -left-4 transform -translate-y-1/2 shadow-lg shadow-emerald-400/50"
                >
                </div>
              </div>

              <!-- Center glitch effect -->
              <div class="w-4 h-4 bg-cyber-cyan rounded-full animate-pulse opacity-80 shadow-lg shadow-cyber-cyan/50 mx-auto my-auto"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Error Message -->
      <div class="mb-8">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-display font-bold text-white mb-4">
          Página no encontrada
        </h2>
        <p class="text-lg md:text-xl text-white/70 max-w-2xl mx-auto mb-8 font-body leading-relaxed">
          La página a la que intentas acceder no existe o ha sido movida. Esto puede ocurrir cuando un
          enlace está roto, la URL se escribió de forma incorrecta o el recurso cambió de lugar.
        </p>
      </div>

      <!-- Separator -->
      <div class="mb-8">
        <div class="flex items-center max-w-md mx-auto">
          <div class="flex-1 h-px bg-gradient-to-r from-transparent via-cyber-cyan/30 to-transparent">
          </div>
          <div class="px-4 text-cyber-cyan text-sm font-mono tracking-wider">¿TE HAS PERDIDO?</div>
          <div class="flex-1 h-px bg-gradient-to-r from-transparent via-cyber-cyan/30 to-transparent">
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <button
          onclick="window.history.back()"
          class="btn-primary inline-flex items-center space-x-2 px-8 py-4 text-white font-semibold shadow-lg shadow-cyber-cyan/20"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Volver Atrás</span>
        </button>

        <a
          href="/"
          class="glass-pill inline-flex items-center space-x-2 px-8 py-4 text-white font-semibold hover:border-cyber-cyan/50"
        >
          <svg class="w-5 h-5 text-cyber-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
            ></path>
          </svg>
          <span>Ir al Inicio</span>
        </a>

        <a
          href="https://github.com/xinzayr"
          target="_blank"
          rel="noopener noreferrer"
          class="glass-pill inline-flex items-center space-x-2 px-8 py-4 text-white font-semibold hover:border-cyber-cyan/50"
        >
          <svg class="w-5 h-5 text-white/80" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          <span>Visitar mi GitHub</span>
        </a>
      </div>

      <!-- Quick Navigation -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
        <a
          href="/projects"
          class="group p-6 glass-card hover:border-cyber-cyan/50 transition-all duration-300"
        >
          <div
            class="w-12 h-12 bg-cyber-cyan/10 rounded-xl border border-cyber-cyan/30 flex items-center justify-center mb-4 mx-auto group-hover:bg-cyber-cyan/20 transition-colors"
          >
            <svg
              class="w-6 h-6 text-cyber-cyan"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              ></path>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Proyectos</h3>
          <p class="text-white/60 text-sm font-body">Explora mis trabajos y creaciones</p>
        </a>

        <a
          href="/blog"
          class="group p-6 glass-card hover:border-cyber-cyan/50 transition-all duration-300"
        >
          <div
            class="w-12 h-12 bg-cyber-cyan/10 rounded-xl border border-cyber-cyan/30 flex items-center justify-center mb-4 mx-auto group-hover:bg-cyber-cyan/20 transition-colors"
          >
            <svg
              class="w-6 h-6 text-cyber-cyan"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Blog</h3>
          <p class="text-white/60 text-sm font-body">Lee mis publicaciones y artículos</p>
        </a>

        <a
          href="/contact"
          class="group p-6 glass-card hover:border-cyber-cyan/50 transition-all duration-300"
        >
          <div
            class="w-12 h-12 bg-cyber-green/10 rounded-xl border border-cyber-green/30 flex items-center justify-center mb-4 mx-auto group-hover:bg-cyber-green/20 transition-colors"
          >
            <svg
              class="w-6 h-6 text-cyber-green"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Contacto</h3>
          <p class="text-white/60 text-sm font-body">Ponte en contacto conmigo</p>
        </a>
      </div>

      <!-- Fun Element -->
      <div class="mt-16 text-center">
        <p class="text-white/40 text-sm mb-4 font-mono">¿SABÍAS QUE...?</p>
        <div class="glass-pill p-4 max-w-md mx-auto">
          <p class="text-white/70 text-sm italic font-body" id="fun-fact">
            El error 404 fue nombrado por la habitación 404 en CERN donde se almacenaba el primer
            servidor web.
          </p>
        </div>
      </div>
    </div>

    <!-- Background Effects -->
    <div class="fixed inset-0 pointer-events-none -z-10">
      <!-- Animated gradient -->
      <div
        class="absolute inset-0 bg-gradient-to-br from-cyber-cyan/10 via-transparent to-cyber-green/10 animate-pulse"
      >
      </div>

      <!-- Floating particles -->
      <div class="absolute top-20 left-10 w-2 h-2 bg-cyber-cyan/50 rounded-full animate-float">
      </div>
      <div
        class="absolute top-40 right-20 w-1 h-1 bg-cyber-green/50 rounded-full animate-float-delayed"
      >
      </div>
      <div
        class="absolute bottom-40 left-1/4 w-3 h-3 bg-cyber-cyan/30 rounded-full animate-float-slow"
      >
      </div>
      <div class="absolute bottom-20 right-1/3 w-1 h-1 bg-emerald-400/50 rounded-full animate-float">
      </div>
    </div>
  </main>

  <Footer />

  <style>
    @keyframes animate-spin-slow {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    .animate-spin-slow {
      animation: animate-spin-slow 10s linear infinite;
    }

    @keyframes float {
      0%,
      100% {
        transform: translateY(0px) rotate(0deg);
      }
      50% {
        transform: translateY(-20px) rotate(180deg);
      }
    }

    @keyframes float-delayed {
      0%,
      100% {
        transform: translateY(0px) rotate(0deg);
      }
      50% {
        transform: translateY(-15px) rotate(-180deg);
      }
    }

    @keyframes float-slow {
      0%,
      100% {
        transform: translateY(0px) scale(1);
      }
      50% {
        transform: translateY(-10px) scale(1.1);
      }
    }

    .animate-float {
      animation: float 3s ease-in-out infinite;
    }

    .animate-float-delayed {
      animation: float-delayed 4s ease-in-out infinite;
      animation-delay: 2s;
    }

    .animate-float-slow {
      animation: float-slow 5s ease-in-out infinite;
      animation-delay: 1s;
    }
  </style>

  <script>
    const funFacts = [
      'El error 404 fue nombrado por la habitación 404 en CERN donde se almacenaba el primer servidor web.',
      'La primera página web de la historia todavía está online desde 1991.',
      "El símbolo '@' se usaba en el siglo XVI para indicar precio por unidad.",
      'El primer banner publicitario en internet tuvo un CTR del 44%.',
      "La palabra 'bug' en programación viene de un insecto real encontrado en una computadora en 1947.",
      'El protocolo HTTP fue diseñado en solo 9 días.',
      'Google procesa más de 8.5 billones de búsquedas al día.',
      'El primer dominio .com registrado fue symbolics.com en 1985.',
    ];

    function showRandomFact() {
      const factElement = document.getElementById('fun-fact');
      if (factElement) {
        const randomFact = funFacts[Math.floor(Math.random() * funFacts.length)];
        factElement.textContent = randomFact;
      }
    }

    function init404Page() {
      showRandomFact();
    }

    init404Page();
    setInterval(showRandomFact, 5000);
    document.addEventListener('astro:page-load', init404Page);
  </script>
</BaseLayout>
