---
import '../styles/global.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
	article?: boolean;
}

const { title, description = "Portafolio personal de xinzayr - Desarrollador Full Stack", image, article = false } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{image && <meta property="og:image" content={image} />}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		{image && <meta property="twitter:image" content={image} />}

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen bg-black text-white font-sans antialiased overflow-x-hidden">
		<slot />

		<!-- Botón flotante de regreso al inicio -->
		<button
			id="back-to-top"
			class="fixed bottom-6 right-6 z-50 w-12 h-12 bg-white/10 hover:bg-white/20 border border-white/20 hover:border-white/30 rounded-full backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none translate-y-4 group"
			aria-label="Volver al inicio"
		>
			<svg
				class="w-5 h-5 mx-auto text-white group-hover:text-white/90 transition-colors"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
			</svg>
		</button>

		<!-- Background gradient -->
		<div class="fixed inset-0 -z-10 bg-gradient-to-br from-black via-gray-900 to-black"></div>

		<!-- Floating particles -->
		<div class="fixed inset-0 pointer-events-none -z-10">
			<div class="absolute top-20 left-10 w-2 h-2 bg-white/10 rounded-full animate-float"></div>
			<div class="absolute top-40 right-20 w-1 h-1 bg-white/20 rounded-full animate-float" style="animation-delay: 2s;"></div>
			<div class="absolute bottom-40 left-1/4 w-1.5 h-1.5 bg-white/15 rounded-full animate-float" style="animation-delay: 4s;"></div>
			<div class="absolute bottom-20 right-1/3 w-1 h-1 bg-white/25 rounded-full animate-float" style="animation-delay: 1s;"></div>
		</div>

		<script>
			// Botón flotante de regreso al inicio
			document.addEventListener('DOMContentLoaded', function() {
				const backToTopBtn = document.getElementById('back-to-top');

				if (backToTopBtn) {
					// Mostrar/ocultar botón basado en scroll
					function toggleBackToTop() {
						const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

						if (scrollTop > 400) {
							if (backToTopBtn) {
								backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
								backToTopBtn.classList.add('opacity-100', 'translate-y-0');
							}
						} else {
							if (backToTopBtn) {
								backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
								backToTopBtn.classList.remove('opacity-100', 'translate-y-0');
							}
						}
					}

					// Scroll suave al inicio
					function scrollToTop() {
						window.scrollTo({
							top: 0,
							behavior: 'smooth'
						});
					}

					// Event listeners
					window.addEventListener('scroll', toggleBackToTop);
					backToTopBtn.addEventListener('click', scrollToTop);

					// Check inicial
					toggleBackToTop();
				}
			});
		</script>
	</body>
</html>
