---
import '../styles/global.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
	article?: boolean;
}

const { title, description = "El Portafolio de Xinzayr - Desarrollador Junior", image, article = false } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{image && <meta property="og:image" content={image} />}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		{image && <meta property="twitter:image" content={image} />}

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen bg-black text-white font-sans antialiased overflow-x-hidden">
		<slot />

		<!-- Background gradient -->
		<div class="fixed inset-0 -z-10 bg-gradient-to-br from-black via-gray-900 to-black"></div>

		<!-- Floating particles -->
		<div class="fixed inset-0 pointer-events-none -z-10">
			<div class="absolute top-20 left-10 w-2 h-2 bg-white/10 rounded-full animate-float"></div>
			<div class="absolute top-40 right-20 w-1 h-1 bg-white/20 rounded-full animate-float" style="animation-delay: 2s;"></div>
			<div class="absolute bottom-40 left-1/4 w-1.5 h-1.5 bg-white/15 rounded-full animate-float" style="animation-delay: 4s;"></div>
			<div class="absolute bottom-20 right-1/3 w-1 h-1 bg-white/25 rounded-full animate-float" style="animation-delay: 1s;"></div>
		</div>
	</body>
</html>
